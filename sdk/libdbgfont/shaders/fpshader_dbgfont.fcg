// libdbgfont fragment program - glyph coverage blit.
//
// Samples the bound 8-bit font atlas and uses its alpha as coverage:
// the output is the vertex colour with alpha scaled by the texel's.
// Blending (SRC_ALPHA, ONE_MINUS_SRC_ALPHA) is enabled by
// cellDbgFontDrawGcm, so minified glyphs keep their strokes as partial
// coverage and magnified ones stay solid.

void main(float4 color : COLOR0,
          float2 texcoord : TEXCOORD0,

          uniform sampler2D texture,

          out float4 oColor : COLOR0)
{
    float4 tex = tex2D(texture, texcoord);
    oColor = float4(color.rgb, color.a * tex.a);
}
