From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FirebirdTA01 <FirebirdTA01@aol.com>
Date: Sun, 18 Oct 2026 17:00:16 -0500
Subject: [PATCH 10/38] spu: smallest_int_mode_for_size returns an
 opt_scalar_int_mode

---
 gcc/config/spu/spu.cc | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/gcc/config/spu/spu.cc b/gcc/config/spu/spu.cc
index 805907ae203..519db947bcd 100644
--- a/gcc/config/spu/spu.cc
+++ b/gcc/config/spu/spu.cc
@@ -3821,7 +3821,7 @@ spu_function_value (const_tree type, const_tree func ATTRIBUTE_UNUSED)
 	{
 	  if (byte_size < 4)
 	    byte_size = 4;
-	  smode = smallest_int_mode_for_size (byte_size * BITS_PER_UNIT);
+	  smode = smallest_int_mode_for_size (byte_size * BITS_PER_UNIT).require ();
 	  RTVEC_ELT (v, n) =
 	    gen_rtx_EXPR_LIST (VOIDmode,
 			       gen_rtx_REG (smode, FIRST_RETURN_REGNUM + n),
@@ -3859,7 +3859,7 @@ spu_function_arg (cumulative_args_t cum_v,
       rtx gr_reg;
       if (byte_size < 4)
 	byte_size = 4;
-      smode = smallest_int_mode_for_size (byte_size * BITS_PER_UNIT);
+      smode = smallest_int_mode_for_size (byte_size * BITS_PER_UNIT).require ();
       gr_reg = gen_rtx_EXPR_LIST (VOIDmode,
 				  gen_rtx_REG (smode, FIRST_ARG_REGNUM + *cum),
 				  const0_rtx);
