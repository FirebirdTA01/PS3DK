From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FirebirdTA01 <FirebirdTA01@aol.com>
Date: Sun, 18 Oct 2026 17:39:34 -0500
Subject: [PATCH] spu: plain char signed, 16-bit wchar_t and int wint_t, as the system

The system SPU compiler makes plain char signed (__CHAR_SIGNED__ 1),
wchar_t a 16-bit unsigned short (__WCHAR_TYPE__ short unsigned int,
__WCHAR_MAX__ 65535U) and wint_t int (measured with its -dM -E for C and
C++, 2026-10-16).  Ours had unsigned char, a 32-bit int wchar_t and an
unsigned int wint_t, so char comparisons, L"" literals and structs holding
wchar_t differed from code built with the system.  An ABI change for
SPU code using plain char or wchar_t; it ships with the PPU char/wchar_t
changes (gcc-16.x 0075/0076) in the GCC 16 switchover release.

(Ported to GCC 16 from patches/spu/gcc-9.5.0/0016-spu-char-signed-wchar-16bit.patch.)
---
 gcc/config/spu/spu-c.cc |  2 ++
 gcc/config/spu/spu.h    | 12 +++++++++++-
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/gcc/config/spu/spu-c.cc b/gcc/config/spu/spu-c.cc
index 74b2cbf0960..be39de89e72 100644
--- a/gcc/config/spu/spu-c.cc
+++ b/gcc/config/spu/spu-c.cc
@@ -191,6 +191,8 @@ void
 spu_cpu_cpp_builtins (struct cpp_reader *pfile)
 {
   cpp_define (pfile, "__SPU__");
+  if (flag_signed_char)
+    cpp_define (pfile, "__CHAR_SIGNED__");
   cpp_assert (pfile, "cpu=spu");
   /* PS3 SPU sources write vector constants as (vector-type)(e1, ..., en)
      and splats as (vector-type)(scalar).  */
diff --git a/gcc/config/spu/spu.h b/gcc/config/spu/spu.h
index b13d0a6b4cf..96aad966ab1 100644
--- a/gcc/config/spu/spu.h
+++ b/gcc/config/spu/spu.h
@@ -129,7 +129,17 @@ extern GTY(()) int spu_tune;
 
 #define LONG_LONG_TYPE_SIZE 64
 
-#define DEFAULT_SIGNED_CHAR 0
+/* Plain char is signed, and wchar_t is a 16-bit unsigned short with an int
+   wint_t, as in the reference SPU toolchain (__CHAR_SIGNED__,
+   __WCHAR_TYPE__ short unsigned int, __WINT_TYPE__ int).  */
+#define DEFAULT_SIGNED_CHAR 1
+
+#undef WCHAR_TYPE
+#define WCHAR_TYPE "short unsigned int"
+#undef WCHAR_TYPE_SIZE
+#define WCHAR_TYPE_SIZE 16
+#undef WINT_TYPE
+#define WINT_TYPE "int"
 
 #define STDINT_LONG32 0
 
