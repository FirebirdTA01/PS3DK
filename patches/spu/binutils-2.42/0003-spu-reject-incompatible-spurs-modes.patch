Reject incompatible SPURS linker modes even when passed through a driver.

Ordinary SPU links retain their existing behavior. Repeating the same SPURS
mode is harmless; selecting distinct modes is an error. A SPURS final-program
mode cannot be combined with relocatable or shared linking.

--- a/ld/emultempl/spuelf.em
+++ b/ld/emultempl/spuelf.em
@@ -42,6 +42,19 @@
   1, 0, 16, 0, 0, 2000
 };
 
+/* Reject incompatible SPURS options here as well as in the GCC specs:
+   -Wl and -Xlinker must not bypass the final-link contract.  */
+static int spurs_program_type = 0;
+
+static void
+spu_set_spurs_program_type (int type)
+{
+  if (spurs_program_type != 0 && spurs_program_type != type)
+    einfo (_("%F%P: conflicting SPURS modes\n"));
+  spurs_program_type = type;
+  spu_elf_set_spurs_job_type (type);
+}
+
 static unsigned int no_overlays = 0;
 static unsigned int num_lines_set = 0;
 static unsigned int line_size_set = 0;
