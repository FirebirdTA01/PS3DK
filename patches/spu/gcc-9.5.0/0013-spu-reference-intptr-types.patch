+for more details.  */
+
+/* Read after newlib-stdint.h, which makes intptr_t and uintptr_t the
+   ptrdiff_t and size_t types (long and unsigned long here).  The PS3 SPU
+   ABI types them int and unsigned int, so the intrinsic overloads accept
+   them and C++ names mangle as other PS3 SPU objects expect.  */
+
+#undef INTPTR_TYPE
+#define INTPTR_TYPE "int"
+
+#undef UINTPTR_TYPE
+#define UINTPTR_TYPE "unsigned int"
