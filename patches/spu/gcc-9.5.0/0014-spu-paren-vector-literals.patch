+/* With -fparen-vector-literals, whether the '(' that follows a cast to a
+   vector type opens an operand list for cp_parser_paren_vector_literal:
+   true unless the matching ')' is followed by a postfix operator, in
+   which case the operand is an ordinary postfix-expression.  */
+
+static bool
+cp_parser_paren_vector_list_p (cp_parser *parser)
+{
+  bool list = false;
+  cp_lexer_save_tokens (parser->lexer);
+  cp_lexer_consume_token (parser->lexer);
+  if (cp_parser_skip_to_closing_parenthesis (parser, false, false,
+					     /*consume_paren=*/true))
+    {
+      cp_token *t = cp_lexer_peek_token (parser->lexer);
+      list = !(t->type == CPP_OPEN_SQUARE || t->type == CPP_OPEN_PAREN
+	       || t->type == CPP_DOT || t->type == CPP_DEREF
+	       || t->type == CPP_PLUS_PLUS || t->type == CPP_MINUS_MINUS);
+    }
+  cp_lexer_rollback_tokens (parser->lexer);
+  return list;
+}
+
+/* Parse the operand list of (TYPE)(e1, ..., en), TYPE a vector type.
+   n >= 2 is a vector literal: each element is converted to the element
+   type as by a C-style cast; missing elements are zero, extra ones are
+   dropped, and either mismatch is warned about.  n == 1 with an
+   arithmetic scalar is a splat; with anything else it is the operand of
+   the ordinary cast the caller builds.  The result has TYPE, or is the
+   single operand.  */
+
+static tree
+cp_parser_paren_vector_literal (cp_parser *parser, tree type)
+{
+  location_t loc = cp_lexer_peek_token (parser->lexer)->location;
+  vec<tree, va_gc> *elts
+    = cp_parser_parenthesized_expression_list (parser, non_attr,
+					       /*cast_p=*/false,
+					       /*allow_expansion_p=*/false,
+					       /*non_constant_p=*/NULL);
+  if (elts == NULL || elts->is_empty ())
+    return error_mark_node;
+  unsigned n = elts->length ();
+  tree eltype = TREE_TYPE (type);
+  unsigned lanes = TYPE_VECTOR_SUBPARTS (type).to_constant ();
+  vec<constructor_elt, va_gc> *ce = NULL;
+  if (n == 1)
+    {
+      tree e = (*elts)[0];
+      tree et = TREE_TYPE (e);
+      if (type_dependent_expression_p (e) || et == NULL_TREE
+	  || VECTOR_TYPE_P (et) || !ARITHMETIC_TYPE_P (et))
+	return e;
+      tree s = build_c_cast (loc, eltype, e);
+      if (!processing_template_decl)
+	s = save_expr (s);
+      for (unsigned i = 0; i < lanes; i++)
+	CONSTRUCTOR_APPEND_ELT (ce, NULL_TREE, s);
+    }
+  else
+    {
+      if (n != lanes)
+	warning_at (loc, 0, "incorrect number of vector elements");
+      for (unsigned i = 0; i < n && i < lanes; i++)
+	CONSTRUCTOR_APPEND_ELT (ce, NULL_TREE,
+				build_c_cast (loc, eltype, (*elts)[i]));
+    }
+  tree init = build_constructor (init_list_type_node, ce);
+  CONSTRUCTOR_IS_DIRECT_INIT (init) = false;
+  return finish_compound_literal (type, init, tf_warning_or_error, fcl_c99);
+}
