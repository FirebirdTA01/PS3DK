+/* Parse the parenthesised operand of a cast to vector type TYPE when
+   -fparen-vector-literals is on.  The next token is the '('.
+
+   (TYPE)(e1, ..., en), n >= 2, is a vector literal: each element is
+   converted to the element type; missing elements are zero, extra ones
+   are dropped, and either mismatch is warned about.
+   (TYPE)(e) is an ordinary cast of the parenthesised expression (postfix
+   operators included) when E is a vector or not arithmetic, and a splat
+   of E converted to the element type when E is an arithmetic scalar.  */
+
+static struct c_expr
+c_parser_paren_vector_literal (c_parser *parser, tree type, location_t loc)
+{
+  struct c_expr ret;
+  ret.original_code = ERROR_MARK;
+  ret.original_type = NULL;
+  location_t open_loc = c_parser_peek_token (parser)->location;
+  matching_parens parens;
+  parens.consume_open (parser);
+  vec<tree, va_gc> *elts = c_parser_expr_list (parser, true, true, NULL,
+					       NULL, NULL, NULL, NULL);
+  location_t close_loc = c_parser_peek_token (parser)->location;
+  parens.skip_until_found_close (parser);
+  unsigned n = vec_safe_length (elts);
+  tree eltype = TREE_TYPE (type);
+  unsigned lanes = TYPE_VECTOR_SUBPARTS (type).to_constant ();
+  if (n == 0)
+    {
+      ret.set_error ();
+      return ret;
+    }
+  if (n == 1)
+    {
+      struct c_expr e;
+      e.value = (*elts)[0];
+      e.original_code = ERROR_MARK;
+      e.original_type = NULL;
+      set_c_expr_source_range (&e, open_loc, close_loc);
+      e = c_parser_postfix_expression_after_primary (parser, open_loc, e);
+      e = convert_lvalue_to_rvalue (open_loc, e, true, true);
+      tree v = e.value;
+      if (v == error_mark_node)
+	{
+	  ret.set_error ();
+	  return ret;
+	}
+      tree vt = TREE_TYPE (v);
+      if (VECTOR_TYPE_P (vt)
+	  || !(INTEGRAL_TYPE_P (vt) || SCALAR_FLOAT_TYPE_P (vt)))
+	ret.value = build_c_cast (loc, type, v);
+      else
+	{
+	  tree s = save_expr (c_fully_fold (build_c_cast (loc, eltype, v), false, NULL));
+	  vec<constructor_elt, va_gc> *ce = NULL;
+	  for (unsigned i = 0; i < lanes; i++)
+	    CONSTRUCTOR_APPEND_ELT (ce, NULL_TREE, s);
+	  ret.value = (TREE_CODE (s) == INTEGER_CST || TREE_CODE (s) == REAL_CST)
+		      ? build_vector_from_ctor (type, ce)
+		      : build_constructor (type, ce);
+	}
+      set_c_expr_source_range (&ret, loc, e.get_finish ());
+      return ret;
+    }
+  if (n != lanes)
+    warning_at (loc, 0, "incorrect number of vector elements");
+  vec<constructor_elt, va_gc> *ce = NULL;
+  bool all_const = true;
+  for (unsigned i = 0; i < n && i < lanes; i++)
+    {
+      tree c = build_c_cast (loc, eltype, (*elts)[i]);
+      if (c == error_mark_node)
+	{
+	  ret.set_error ();
+	  return ret;
+	}
+      c = c_fully_fold (c, false, NULL);
+      if (TREE_CODE (c) != INTEGER_CST && TREE_CODE (c) != REAL_CST)
+	all_const = false;
+      CONSTRUCTOR_APPEND_ELT (ce, NULL_TREE, c);
+    }
+  if (all_const)
+    ret.value = build_vector_from_ctor (type, ce);
+  else
+    {
+      /* a non-constant constructor has every lane */
+      for (unsigned i = n; i < lanes; i++)
+	CONSTRUCTOR_APPEND_ELT (ce, NULL_TREE, build_zero_cst (eltype));
+      ret.value = build_constructor (type, ce);
+    }
+  set_c_expr_source_range (&ret, loc, close_loc);
+  return ret;
+}
