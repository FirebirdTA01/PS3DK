+/* A job linked with its CRT and a custom module are relocated at load time from
+   their fixup tables, so their absolute data words are expected: do not refuse
+   them unless asked to.  A custom module is always position-independent, which
+   also selects the pic multilib.  */
+#define DRIVER_SELF_SPECS \
+  "%{mspurs-job-initialize|mcustom-module:%{!merror-reloc:%{!mwarn-reloc:-mno-error-reloc}}}", \
+  "%{mcustom-module:%{!fpic:%{!fPIC:-fpic}}}"
+
 #define SPU_ORDINARY_LIB_SPEC "-( %{!shared:%{g*:-lg}} -lc -lgloss -lsputhread -) \
     %{mno-atomic-updates:-lgcc_cachemgr_nonatomic; :-lgcc_cachemgr} \
     %{mcache-size=128:-lgcc_cache128k; \
