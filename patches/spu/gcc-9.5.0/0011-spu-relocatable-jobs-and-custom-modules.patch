diff -ruN a/libgcc/config/spu/init_fixups.S b/libgcc/config/spu/init_fixups.S
--- a/libgcc/config/spu/init_fixups.S
+++ b/libgcc/config/spu/init_fixups.S
@@ -0,0 +1,94 @@
+/* Start-up and shut-down of a position-independent SPU image
+   (-mcustom-module).
+
+   Such an image is linked at address 0 with --emit-fixups, which lists
+   every word holding an absolute address in .fixup: one word per
+   quadword, the quadword's link address with bit 8 >> n set for each of
+   its words n to relocate, ending with a zero word.  The .init fragment
+   below runs in _init (crti.o's frame) before the .ctors constructors:
+   it adds the image's load address to each listed word, then runs the
+   .init_array constructors (an image of this kind has no crt0 to run
+   them).  The .fini fragment runs the .fini_array destructors.  Call
+   _init once per load of the image.  */
+
+	.section .init,"ax",@progbits
+	brsl	$lr, __spu_init_image
+
+	.section .fini,"ax",@progbits
+	brsl	$lr, __spu_fini_image
+
+	.text
+	.align	3
+	.type	__spu_init_image, @function
+__spu_init_image:
+	stqd	$lr, 16($sp)
+	stqd	$80, -16($sp)
+	stqd	$81, -32($sp)
+	stqd	$sp, -64($sp)
+	ai	$sp, $sp, -64
+	ila	$2, 1f			/* link address of 1: */
+	brsl	$3, 1f			/* run-time address of 1: */
+1:	sf	$80, $2, $3		/* $80 = load delta */
+	brz	$80, 3f			/* loaded where linked: no relocation */
+	ila	$5, 0x10203
+	shufb	$4, $80, $80, $5	/* delta in every word */
+	ila	$6, __fixup_start
+	a	$6, $6, $80		/* run-time address of the table */
+2:	lqd	$7, 0($6)
+	rotqby	$7, $7, $6		/* this record in the preferred word */
+	ai	$6, $6, 4
+	brz	$7, 3f			/* zero record: done */
+	andi	$8, $7, -16
+	a	$8, $8, $80		/* run-time address of the quadword */
+	fsm	$9, $7			/* word select from the record's low bits */
+	and	$9, $9, $4
+	lqd	$10, 0($8)
+	a	$10, $10, $9
+	stqd	$10, 0($8)
+	br	2b
+3:	ila	$81, __init_array_start
+	a	$81, $81, $80
+4:	ila	$2, __init_array_end
+	a	$2, $2, $80
+	clgt	$3, $2, $81		/* more entries? */
+	brz	$3, 5f
+	lqd	$4, 0($81)
+	rotqby	$4, $4, $81
+	ai	$81, $81, 4
+	bisl	$lr, $4
+	br	4b
+5:	ai	$sp, $sp, 64
+	lqd	$lr, 16($sp)
+	lqd	$80, -16($sp)
+	lqd	$81, -32($sp)
+	bi	$lr
+	.size	__spu_init_image, . - __spu_init_image
+
+	.align	3
+	.type	__spu_fini_image, @function
+__spu_fini_image:
+	stqd	$lr, 16($sp)
+	stqd	$80, -16($sp)
+	stqd	$81, -32($sp)
+	stqd	$sp, -64($sp)
+	ai	$sp, $sp, -64
+	ila	$2, 1f
+	brsl	$3, 1f
+1:	sf	$80, $2, $3		/* load delta */
+	ila	$81, __fini_array_end
+	a	$81, $81, $80
+2:	ila	$2, __fini_array_start
+	a	$2, $2, $80
+	clgt	$3, $81, $2		/* more entries (last first)? */
+	brz	$3, 3f
+	ai	$81, $81, -4
+	lqd	$4, 0($81)
+	rotqby	$4, $4, $81
+	bisl	$lr, $4
+	br	2b
+3:	ai	$sp, $sp, 64
+	lqd	$lr, 16($sp)
+	lqd	$80, -16($sp)
+	lqd	$81, -32($sp)
+	bi	$lr
+	.size	__spu_fini_image, . - __spu_fini_image
