spu: plain char signed, 16-bit wchar_t and int wint_t, as the reference

The reference SPU compiler makes plain char signed (predefining
__CHAR_SIGNED__ and extending with xsbh), wchar_t a 16-bit unsigned short
(__WCHAR_MAX__ 65535) and wint_t int.  Ours had unsigned char, a 32-bit int
wchar_t and an unsigned int wint_t, so char comparisons, L"" literals and
structs holding wchar_t differed from code built with the reference.  An ABI
change for SPU code using plain char or wchar_t; it ships with the PPU
char/wchar_t changes in v0.20.0.

--- a/gcc/config/spu/spu.h
+++ b/gcc/config/spu/spu.h
@@ -135,7 +135,17 @@
 
 #define LONG_DOUBLE_TYPE_SIZE 64
 
-#define DEFAULT_SIGNED_CHAR 0
+/* Plain char is signed, and wchar_t is a 16-bit unsigned short with an int
+   wint_t, as in the reference SPU toolchain (__CHAR_SIGNED__,
+   __WCHAR_TYPE__ short unsigned int, __WINT_TYPE__ int).  */
+#define DEFAULT_SIGNED_CHAR 1
+
+#undef WCHAR_TYPE
+#define WCHAR_TYPE "short unsigned int"
+#undef WCHAR_TYPE_SIZE
+#define WCHAR_TYPE_SIZE 16
+#undef WINT_TYPE
+#define WINT_TYPE "int"
 
 #define STDINT_LONG32 0
 
--- a/gcc/config/spu/spu-c.c
+++ b/gcc/config/spu/spu-c.c
@@ -187,6 +187,8 @@
 spu_cpu_cpp_builtins (struct cpp_reader *pfile)
 {
   cpp_define (pfile, "__SPU__");
+  if (flag_signed_char)
+    cpp_define (pfile, "__CHAR_SIGNED__");
   cpp_assert (pfile, "cpu=spu");
   /* PS3 SPU sources write vector constants as (vector-type)(e1, ..., en)
      and splats as (vector-type)(scalar).  */
