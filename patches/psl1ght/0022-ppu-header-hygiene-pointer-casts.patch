 }
 
@@ -110,7 +110,7 @@ LV2_SYSCALL sysLv2FsFsync(s32 fd)
 
 LV2_SYSCALL sysLv2FsTruncate(const char *path,u64 size)
 {
-	lv2syscall2(831,(u64)path,size);
