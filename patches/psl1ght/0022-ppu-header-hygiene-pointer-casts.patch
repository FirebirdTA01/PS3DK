 {
-	lv2syscall2(811,(u64)path,mode);
+	lv2syscall2(811,(u64)(uintptr_t)path,mode);
 	return_to_user_prog(s32);
 }
 
 LV2_SYSCALL sysLv2FsRename(const char *path,const char *newpath)
