diff --git a/newlib/libc/sys/lv2/getreent.c b/newlib/libc/sys/lv2/getreent.c
new file mode 100644
index 0000000..a000001
--- /dev/null
+++ b/newlib/libc/sys/lv2/getreent.c
@@ -0,0 +1,62 @@
+/* Per-thread _reent storage for the LV2 hybrid ILP32 ABI.
+ *
+ * Compiler __thread cannot be used here: under the ELF64 + ILP32 data
+ * model, GCC emits .long sym@dtprel for DWARF TLS info, but the only
+ * @dtprel relocation available in the PPC64 ELF is R_PPC64_DTPREL64
+ * (eight bytes), which the assembler refuses to fit in four-byte storage.
+ * Per-thread _reent is keyed off the LV2 thread ID instead.
+ *
+ * sys_ppu_thread_get_id is the LV2 ABI's sysPrxForUser SPRX export for
+ * fetching the current thread id; any LV2 runtime that links libc.a
+ * provides this symbol.  Apps without an LV2 runtime get a normal
+ * undefined-symbol link error.  No single-thread fallback. */
+
+#include <reent.h>
+#include <stdint.h>
+#include <string.h>   /* memset, used by _REENT_INIT_PTR */
+
+typedef uint64_t _ps3_thread_id_t;
+
+extern int sys_ppu_thread_get_id(_ps3_thread_id_t *thread_id);
+
+#define REENT_TABLE_SIZE 16
+
+static struct {
+	_ps3_thread_id_t tid;
+	struct _reent reent;
+	int initialized;
+} reent_slots[REENT_TABLE_SIZE];
+
+/* Used only when sys_ppu_thread_get_id itself fails at runtime (e.g.,
+ * thread context not yet established).  Not a missing-symbol fallback. */
+static struct _reent _runtime_fallback_reent;
+static int _runtime_fallback_inited;
+
+struct _reent *__getreent(void)
+{
+	_ps3_thread_id_t tid;
+	if (sys_ppu_thread_get_id(&tid) != 0) {
+		if (!_runtime_fallback_inited) {
+			_REENT_INIT_PTR(&_runtime_fallback_reent);
+			_runtime_fallback_inited = 1;
+		}
+		return &_runtime_fallback_reent;
+	}
+	unsigned base = (unsigned)tid & (REENT_TABLE_SIZE - 1);
+	for (int i = 0; i < REENT_TABLE_SIZE; i++) {
+		unsigned idx = (base + i) & (REENT_TABLE_SIZE - 1);
+		if (reent_slots[idx].initialized && reent_slots[idx].tid == tid)
+			return &reent_slots[idx].reent;
+		if (!reent_slots[idx].initialized) {
+			reent_slots[idx].tid = tid;
+			_REENT_INIT_PTR(&reent_slots[idx].reent);
+			reent_slots[idx].initialized = 1;
+			return &reent_slots[idx].reent;
+		}
+	}
+	if (!_runtime_fallback_inited) {
+		_REENT_INIT_PTR(&_runtime_fallback_reent);
+		_runtime_fallback_inited = 1;
+	}
+	return &_runtime_fallback_reent;
+}
diff --git a/newlib/libc/sys/lv2/lock.c b/newlib/libc/sys/lv2/lock.c
new file mode 100644
index 0000000..4e32e44
--- /dev/null
+++ b/newlib/libc/sys/lv2/lock.c
@@ -0,0 +1,37 @@
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <sys/lock.h>
+
+#include "lock_internal.h"
+
+int __libc_lock_init(__libc_lock_t *lock)
+{
+	return sys_lwmutex_create(lock,&__libc_lock_attributes);
+}
+
+int __libc_lock_close(__libc_lock_t *lock)
+{
+  return sys_lwmutex_destroy(lock);
+}
+
+int __libc_lock_acquire(__libc_lock_t *lock)
+{
+	if(SYS_LWMUTEX_UNINITIALIZED(lock))
+    __libc_auto_lock_allocate(lock);
+	return  sys_lwmutex_lock(lock,0);
+}
+
+int __libc_lock_try_acquire(__libc_lock_t *lock)
+{
+	if(SYS_LWMUTEX_UNINITIALIZED(lock))
+    __libc_auto_lock_allocate(lock);
+  return sys_lwmutex_trylock(lock);
+}
+
+int __libc_lock_release(__libc_lock_t *lock)
+{
+	if(SYS_LWMUTEX_UNINITIALIZED(lock))
+    __libc_auto_lock_allocate(lock);
+  return sys_lwmutex_unlock(lock);
+}
diff --git a/newlib/libc/sys/lv2/lock_internal.c b/newlib/libc/sys/lv2/lock_internal.c
new file mode 100644
index 0000000..7a07e3e
--- /dev/null
+++ b/newlib/libc/sys/lv2/lock_internal.c
@@ -0,0 +1,99 @@
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <sys/lock.h>
+
+#include "lock_internal.h"
+
+/* The lock that serialises lazy lock creation.  It is created by the
+   start-up constructor below, at priority 85: the runtime ladder (heap 83,
+   syscall table 84, this lock 85, finalization 86) runs in the
+   implementation-reserved range, ahead of libstdc++'s own constructors (90
+   and 98 in GCC 16) and every user constructor (101 and up).
+
+   An implementation constructor below 85 can still take a libc lock first,
+   so creation on first use stays, safe for any thread: whoever moves the
+   state from 0 to 1 creates the lock and publishes it with a release store
+   of 2.  Everyone else sleeps until they acquire-load 2.  Sleeping (not
+   spinning, not yielding) lets a lower-priority creator run even when
+   higher-priority waiters would otherwise occupy every PPU thread.
+
+   Test hooks, empty in the library: LOCK_INTERNAL_TEST_AFTER_CLAIM runs in
+   the creator between winning the claim and creating the lock, and
+   LOCK_INTERNAL_TEST builds without the constructor, so the
+   metalock-contested regression row can run this exact source with a
+   delayed creator and higher-priority waiters. */
+static sys_lwmutex_t metaLock;
+static int metaLockState;	/* 0 none, 1 being created, 2 ready */
+
+#ifndef LOCK_INTERNAL_TEST_AFTER_CLAIM
+#define LOCK_INTERNAL_TEST_AFTER_CLAIM() ((void)0)
+#endif
+
+/* sys_timer_usleep (lv2 syscall 141), issued directly: this runs before
+   libc is usable, so it must not take a libc lock or need the syscall
+   table.  Same registers and clobbers as the SDK's lv2syscall1. */
+static void metalock_sleep(uint64_t usec)
+{
+	register uint64_t p1 __asm__("3") = usec;
+	register uint64_t p2 __asm__("4");
+	register uint64_t p3 __asm__("5");
+	register uint64_t p4 __asm__("6");
+	register uint64_t p5 __asm__("7");
+	register uint64_t p6 __asm__("8");
+	register uint64_t p7 __asm__("9");
+	register uint64_t p8 __asm__("10");
+	register uint64_t scn __asm__("11") = 141;
+	__asm__ __volatile__("sc"
+		: "=r"(p1), "=r"(p2), "=r"(p3), "=r"(p4), "=r"(p5), "=r"(p6),
+		  "=r"(p7), "=r"(p8), "=r"(scn)
+		: "r"(p1), "r"(p2), "r"(p3), "r"(p4), "r"(p5), "r"(p6), "r"(p7),
+		  "r"(p8), "r"(scn)
+		: "r0", "r12", "lr", "ctr", "xer", "cr0", "cr1", "cr5", "cr6",
+		  "cr7", "memory");
+}
+
+static void create_metalock(void)
+{
+	int expected = 0;
+
+	if(__atomic_load_n(&metaLockState, __ATOMIC_ACQUIRE) == 2)
+		return;
+	if(__atomic_compare_exchange_n(&metaLockState, &expected, 1, 0,
+	                               __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+		LOCK_INTERNAL_TEST_AFTER_CLAIM();
+		if(sys_lwmutex_create(&metaLock,&__libc_lock_attributes))
+			abort();
+		__atomic_store_n(&metaLockState, 2, __ATOMIC_RELEASE);
+		return;
+	}
+	while(__atomic_load_n(&metaLockState, __ATOMIC_ACQUIRE) != 2)
+		metalock_sleep(50);
+}
+
+#ifndef LOCK_INTERNAL_TEST
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wprio-ctor-dtor"
+static void init_metalock(void) __attribute__((constructor(85)));
+#pragma GCC diagnostic pop
+static void init_metalock(void)
+{
+	create_metalock();
+}
+#endif
+
+void __libc_auto_lock_allocate(sys_lwmutex_t *lwmutex)
+{
+	create_metalock();
+
+	if(sys_lwmutex_lock(&metaLock,0))
+		abort();
+
+	if(SYS_LWMUTEX_UNINITIALIZED(lwmutex)) {
+		if(sys_lwmutex_create(lwmutex,&__libc_lock_attributes))
+			abort();
+	}
+
+	if(sys_lwmutex_unlock(&metaLock))
+		abort();
+}
