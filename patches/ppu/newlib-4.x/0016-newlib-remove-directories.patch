diff --git a/newlib/libc/stdio/remove.c b/newlib/libc/stdio/remove.c
index d8dfdbd8..ac013e64 100644
--- a/newlib/libc/stdio/remove.c
+++ b/newlib/libc/stdio/remove.c
@@ -57,13 +57,29 @@ Supporting OS subroutine required: <<unlink>>.
 #include <_ansi.h>
 #include <reent.h>
 #include <stdio.h>
+#if defined(__PPU__) || defined(__lv2ppu__)
+#include <errno.h>
+#include <sys/syscalls.h>
+#endif
 
 int
 _remove_r (struct _reent *ptr,
        const char *filename)
 {
   if (_unlink_r (ptr, filename) == -1)
-    return -1;
+    {
+#if defined(__PPU__) || defined(__lv2ppu__)
+      /* Lv-2 unlink rejects directories. Keep the caller's reent when
+         dispatching the directory operation, including its error result. */
+      if (ptr->_errno == EISDIR)
+        {
+          if (__syscalls.rmdir_r)
+            return __syscalls.rmdir_r (ptr, filename);
+          ptr->_errno = ENOSYS;
+        }
+#endif
+      return -1;
+    }
 
   return 0;
 }
