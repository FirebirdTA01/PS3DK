+#
+# libgcc's gthr-posix.h refers to the pthread functions weakly and takes
+# pthread_cancel as the sign that a thread library is linked.  Static
+# archives are not searched for weak references, so a program whose only
+# thread library use is libgcc's (raw lv2 threads, no direct pthread
+# call) would run libgcc's unwinder registration unlocked.  librt, which
+# implements pthreads, is on every link (LIB_LV2_SPEC), so refer to it
+# strongly: __gthread_active_p is then always true, as libstdc++'s
+# os/newlib configuration already makes it for C++ code.  Harmless with
+# --enable-threads=single (gthr-single.h ignores it).
+HOST_LIBGCC2_CFLAGS += -DGTHREAD_USE_WEAK=0
