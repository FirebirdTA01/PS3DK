From: PS3 Custom Toolchain
Subject: [PATCH] rs6000: plain char is signed in the cell64lv2 ILP32 data model

The system PPU toolchain makes plain char signed in its default 32-bit
data model (predefining __CHAR_SIGNED__) and unsigned under -mlp64
(predefining __CHAR_UNSIGNED__); measured with the established compiler's
-dM -E for C and C++ in both data models.  Ours was unsigned in both, so
char comparisons, char-to-int conversions and C++ overload resolution on
char differed from code built with the system.

Set flag_signed_char from the data model in option override, unless the
user passed -fsigned-char or -funsigned-char.  Option override runs
before the front end builds char_type_node and predefines
__CHAR_UNSIGNED__, so the type and the macro follow.  An ABI change for
code that passes or stores plain char; GCC 16 port of gcc-12.x 0052.

--- a/gcc/config/rs6000/rs6000.cc
+++ b/gcc/config/rs6000/rs6000.cc
@@ -3674,6 +3674,15 @@
   if (!OPTION_SET_P (flag_variable_expansion_in_unroller))
     flag_variable_expansion_in_unroller = 1;
 
+#ifdef POWERPC_CELL64LV2
+  /* Plain char is signed in the ILP32 data model and unsigned under -mlp64,
+     as the platform ABI specifies, unless -f[un]signed-char was given.
+     Option override runs before the front end builds char_type_node and
+     predefines __CHAR_UNSIGNED__, so the type and the macro follow.  */
+  if (!OPTION_SET_P (flag_signed_char))
+    flag_signed_char = !TARGET_LP64;
+#endif
+
   /* The LP64 data model puts 8-byte pointers and longs in 64-bit
      registers; it has no meaning without the 64-bit mode.  Judge the
      final options, so -mlp64 -m32 -m64 stays valid while -mlp64 -m32
--- a/gcc/config/rs6000/cell64lv2.h
+++ b/gcc/config/rs6000/cell64lv2.h
@@ -270,6 +270,9 @@
 	builtin_define ("_CALL_LINUX");		\
       builtin_assert ("cpu=powerpc64");		\
       builtin_assert ("machine=powerpc64");		\
+      /* Plain-char signedness, as the reference predefines it.  */ \
+      if (flag_signed_char)				\
+	builtin_define ("__CHAR_SIGNED__");		\
 						\
       /* Data-model axis: TARGET_LP64 is the multilib opt-in; \
          default is ILP32 hybrid. */ \
