+#
+# This target has no dl_iterate_phdr: every object's unwind info is
+# registered (crtbegin.o, __register_frame*) and found through
+# unwind-dw2-fde.c alone.  That file enables its lock-free b-tree lookup
+# (ATOMIC_FDE_FAST_PATH) only when unwind-dw2-fde-dip.c includes it, so
+# here every _Unwind_Find_FDE took object_mutex - with
+# --enable-threads=posix a real lock per frame per unwind phase.  Ask for
+# the b-tree in the direct build too (unwind-dw2-fde.c).
+HOST_LIBGCC2_CFLAGS += -DLIBGCC_PS3_ATOMIC_FDE_FAST_PATH=1
--- a/libgcc/unwind-dw2-btree.h
+++ b/libgcc/unwind-dw2-btree.h
@@ -345,6 +345,83 @@
   t->root_lock.version_lock = 0;
 };
 
+#ifdef ATOMIC_FDE_BOOT_RESERVE
+/* A target whose startup code registers frames before the heap exists
+   (crtbegin from _init, ahead of the prioritized constructors that create
+   the heap) takes its first nodes from a static reserve until the runtime
+   sets __ps3dk_heap_ready.  Reserve nodes are never freed.  Running out of
+   the reserve before the heap is ready executes a trap: it is never covered
+   by a malloc that cannot work yet.  After the heap is ready, a failed
+   malloc aborts instead of storing through a null node.  Both outcomes are
+   this target's contract, not upstream behaviour.  The flag is a hard
+   link-time requirement, never assumed: a CRT that does not define it
+   (an older runtime, whose crtbegin also registers before the heap) fails
+   to link instead of reaching malloc too early.  A custom CRT opts in by
+   defining it and setting it once malloc works.  */
+extern int __ps3dk_heap_ready;
+static struct btree_node btree_boot_reserve[ATOMIC_FDE_BOOT_RESERVE];
+/* Reserve nodes handed out (high-water), and nodes taken from malloc.  For
+   tests; updated atomically, so read them with an atomic load.  */
+unsigned __gcc_ps3_fde_boot_nodes;
+unsigned __gcc_ps3_fde_heap_nodes;
+
+static inline bool
+btree_heap_ready (void)
+{
+  return __atomic_load_n (&__ps3dk_heap_ready, __ATOMIC_ACQUIRE);
+}
+
+// Is N one of the reserve's own elements?  Pointer equality only: a
+// malloced node is a different object, not ordered against the array.
+static inline bool
+btree_node_is_boot (const struct btree_node *n)
+{
+  for (unsigned i = 0; i < ATOMIC_FDE_BOOT_RESERVE; ++i)
+    if (n == &btree_boot_reserve[i])
+      return true;
+  return false;
+}
+
+static struct btree_node *
+btree_new_node (void)
+{
+  if (!btree_heap_ready ())
+    {
+      unsigned i = __atomic_fetch_add (&__gcc_ps3_fde_boot_nodes, 1,
+				       __ATOMIC_RELAXED);
+      if (i >= ATOMIC_FDE_BOOT_RESERVE)
+	__builtin_trap ();
+      return &btree_boot_reserve[i];
+    }
+  struct btree_node *n
+    = (struct btree_node *) malloc (sizeof (struct btree_node));
+  if (!n)
+    abort ();
+  __atomic_fetch_add (&__gcc_ps3_fde_heap_nodes, 1, __ATOMIC_RELAXED);
+  return n;
+}
+
+// Free a node's memory; a reserve node is never freed.
+static inline void
+btree_free_node (struct btree_node *n)
+{
+  if (!btree_node_is_boot (n))
+    free (n);
+}
+#else
+static inline struct btree_node *
+btree_new_node (void)
+{
+  return (struct btree_node *) malloc (sizeof (struct btree_node));
+}
+
+static inline void
+btree_free_node (struct btree_node *n)
+{
+  free (n);
+}
+#endif
+
 static void
 btree_release_tree_recursively (struct btree *t, struct btree_node *n);
 
@@ -362,7 +439,7 @@
   while (t->free_list)
     {
       struct btree_node *next = t->free_list->content.children[0].child;
-      free (t->free_list);
+      btree_free_node (t->free_list);
       t->free_list = next;
     }
 }
@@ -400,8 +477,7 @@
 	}
 
       // No free node available, allocate a new one.
-      struct btree_node *new_node
-	= (struct btree_node *) malloc (sizeof (struct btree_node));
+      struct btree_node *new_node = btree_new_node ();
       // Initialize the node in locked state.
       version_lock_initialize_locked_exclusive (&new_node->version_lock);
       new_node->entry_count = 0;
--- a/libgcc/unwind-dw2-fde.c
+++ b/libgcc/unwind-dw2-fde.c
@@ -35,6 +35,21 @@
 #include "unwind-pe.h"
 #include "unwind-dw2-fde.h"
 #include "gthr.h"
+/* A target with no dl_iterate_phdr registers every object here, so the
+   b-tree lookup is wanted in this direct build as well (t-ps3-unwind).
+   Its trees then hold the program's own frames: they are kept until the
+   process ends instead of being destroyed by a destructor, after which a
+   throw from a later destructor would find no FDE.  */
+#if defined(LIBGCC_PS3_ATOMIC_FDE_FAST_PATH) \
+    && (defined(__GTHREAD_MUTEX_INIT) || defined(__GTHREAD_MUTEX_INIT_FUNCTION)) \
+    && defined(__GCC_HAVE_SYNC_COMPARE_AND_SWAP_4)
+#define ATOMIC_FDE_FAST_PATH 1
+#define ATOMIC_FDE_KEEP_TREES 1
+/* crtbegin registers the program from _init, before the heap exists: its
+   two root leaves (one per tree, predicted from the tree layout) come from
+   a static reserve.  */
+#define ATOMIC_FDE_BOOT_RESERVE 2
+#endif
 #else
 #if (defined(__GTHREAD_MUTEX_INIT) || defined(__GTHREAD_MUTEX_INIT_FUNCTION)) \
     && defined(__GCC_HAVE_SYNC_COMPARE_AND_SWAP_4)
@@ -49,6 +64,9 @@
 
 static struct btree registered_frames;
 static struct btree registered_objects;
+#ifdef ATOMIC_FDE_KEEP_TREES
+static const bool in_shutdown = false;
+#else
 static bool in_shutdown;
 
 static void
@@ -62,6 +80,7 @@
   btree_destroy (&registered_objects);
   in_shutdown = true;
 }
+#endif
 
 static void
 get_pc_range (const struct object *ob, uintptr_type *range);
@@ -106,10 +125,18 @@
 #endif
 
 #ifdef ATOMIC_FDE_FAST_PATH
+#ifdef ATOMIC_FDE_BOOT_RESERVE
+/* Registrations made before the runtime reported the heap ready (tests).  */
+unsigned __gcc_ps3_fde_boot_registrations;
+#endif
 // Register the pc range for a given object in the lookup structure.
 static void
 register_pc_range_for_object (uintptr_type begin, struct object *ob)
 {
+#ifdef ATOMIC_FDE_BOOT_RESERVE
+  if (!btree_heap_ready ())
+    __atomic_fetch_add (&__gcc_ps3_fde_boot_registrations, 1, __ATOMIC_RELAXED);
+#endif
   // Register the object itself to know the base pointer on deregistration.
   btree_insert (&registered_objects, begin, 1, ob);
 
