+    glibcxx_cv_symlink=no
+    glibcxx_cv_readlink=no
+    glibcxx_cv_fchmod=no
+    ;;
+esac
 
   ac_ext=cpp
 ac_cpp='$CXXCPP $CPPFLAGS'
