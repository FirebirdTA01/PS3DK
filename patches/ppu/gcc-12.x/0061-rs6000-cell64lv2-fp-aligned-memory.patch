From: PS3 Custom Toolchain
Subject: [PATCH] rs6000: no FP loads or stores through under-aligned memory on cell64lv2

On a PS3, an lfs/lfd/stfs/stfd whose address is not aligned to the access
size raises an alignment interrupt and the kernel ends the PPU thread.
Nothing is reported, and the rest of the process keeps running.  RPCS3 does
not model the fault.  Measured on hardware: lfs from an address 2 mod 4
stops the thread; the same load 4-aligned does not.

GCC already treats such accesses as slow (rs6000_slow_unaligned_access),
and the middle end expands them as integer loads: memcpy (&f, p, 4) from a
char pointer becomes an SImode load with MEM_ALIGN 8.  But combine then
folds "integer load + move to an FPR" back into an FPR load from the same
address, and the SF/DF move patterns accepted any memory operand.  At -O2,
float f; memcpy (&f, p, 4) compiled to a single lfs from p, and a packed
struct's float member could compile to lfs at a misaligned offset even at
-O0.

New memory constraint "eF": on cell64lv2 a MEM whose MEM_ALIGN is at least
its mode's natural alignment (32 bits for SFmode, 64 for DFmode and
DImode); on every other target it is "m".  It replaces "m" in the
FPR-memory alternatives of movsf_hardfloat, *mov<mode>_hardfloat32/64,
*extendsfdf2_fpr and *movdi_internal32/64.  Aligned accesses match as
before.  An under-aligned one has no FPR-memory alternative, so register
allocation moves it through the GPR alternatives (integer loads/stores and
an aligned stack slot), as -mstrict-align does, but for FP data only.
Integer accesses are not affected.

Frame slots count as aligned when their MEM carries no alignment: an
offset that is a multiple of the access size from the stack pointer, the
frame pointer (r31 only when the function has one), the arg pointer or a
virtual register.  The prologue's FPR saves (stfd f14,3568(r1)) are A8,
and without this rule the first build of libgcc's unwinder ICEd in
extract_constrain_insn.
--- a/gcc/config/rs6000/constraints.md
+++ b/gcc/config/rs6000/constraints.md
@@ -257,6 +257,15 @@
   (and (match_code "mem")
        (match_test "GET_RTX_CLASS (GET_CODE (XEXP (op, 0))) != RTX_AUTOINC")))
 
+(define_memory_constraint "eF"
+  "@internal
+   A memory operand that a floating-point load or store may use.  On
+   CellOS Lv-2 an lfs/lfd/stfs/stfd whose address is not aligned to the
+   access size raises an alignment interrupt that ends the PPU thread, so
+   there it must be naturally aligned; everywhere else this is @code{m}."
+  (and (match_code "mem")
+       (match_test "rs6000_fp_mem_aligned_p (op)")))
+
 (define_memory_constraint "Q"
   "A memory operand addressed by just a base register."
   (and (match_code "mem")
--- a/gcc/config/rs6000/rs6000-protos.h
+++ b/gcc/config/rs6000/rs6000-protos.h
@@ -141,6 +141,7 @@ extern bool valid_sf_si_move (rtx, rtx, machine_mode);
 extern void rs6000_emit_move (rtx, rtx, machine_mode);
 extern bool rs6000_legitimate_offset_address_p (machine_mode, rtx,
 						bool, bool);
+extern bool rs6000_fp_mem_aligned_p (rtx);
 extern rtx rs6000_find_base_term (rtx);
 extern rtx rs6000_return_addr (int, rtx);
 extern void rs6000_output_symbol_ref (FILE*, rtx);
--- a/gcc/config/rs6000/rs6000.cc
+++ b/gcc/config/rs6000/rs6000.cc
@@ -29013,6 +29013,58 @@ rs6000_opaque_type_invalid_use_p (gimple *stmt)
   return false;
 }
 
+/* Whether MEM may be the memory operand of a floating-point load or
+   store (constraint "eF").  On CellOS Lv-2 a misaligned lfs/lfd/stfs/stfd
+   raises an alignment interrupt and the kernel ends the thread, silently:
+   the rest of the process keeps running.  RPCS3 does not model it.  The
+   middle end already treats such accesses as slow and expands them as
+   integer loads (a memcpy into a float becomes an SImode load), but
+   combine then folds "integer load + move to an FPR" back into an FPR
+   load from the same address, and the move patterns accepted any memory.
+   Requiring the mode's natural alignment for the FPR alternatives leaves
+   aligned code unchanged and sends the rest through the GPR alternatives.  */
+
+bool
+rs6000_fp_mem_aligned_p (rtx mem)
+{
+#ifdef POWERPC_CELL64LV2
+  unsigned int align = GET_MODE_ALIGNMENT (GET_MODE (mem));
+  if (MEM_ALIGN (mem) >= align)
+    return true;
+
+  /* Register saves, spills and other frame slots are addressed from the
+     stack, frame or argument pointer, which the ABI keeps aligned, but
+     their MEMs often carry no alignment (the prologue's FPR saves are
+     A8).  An offset that is a multiple of the access size from one of
+     those registers is aligned.  */
+  rtx addr = XEXP (mem, 0);
+  HOST_WIDE_INT offset = 0;
+  if (GET_CODE (addr) == PLUS && CONST_INT_P (XEXP (addr, 1)))
+    {
+      offset = INTVAL (XEXP (addr, 1));
+      addr = XEXP (addr, 0);
+    }
+  if (REG_P (addr)
+      && (REGNO (addr) == STACK_POINTER_REGNUM
+	  /* r31 is the frame pointer only when the function has one;
+	     otherwise it is an ordinary register that may hold any
+	     pointer.  */
+	  || (REGNO (addr) == HARD_FRAME_POINTER_REGNUM
+	      && frame_pointer_needed)
+	  || REGNO (addr) == FRAME_POINTER_REGNUM
+	  || REGNO (addr) == ARG_POINTER_REGNUM
+	  || (REGNO (addr) >= FIRST_VIRTUAL_REGISTER
+	      && REGNO (addr) <= LAST_VIRTUAL_REGISTER))
+      && offset % (align / BITS_PER_UNIT) == 0)
+    return true;
+
+  return false;
+#else
+  (void) mem;
+  return true;
+#endif
+}
+
 #ifdef POWERPC_CELL64LV2
 /* PS3 / Cell64 LV2: allow SImode pointers on a 64-bit target so that
    32-bit effective-address code works correctly.  */
