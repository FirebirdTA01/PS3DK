rs6000: plain char is signed in the cell64lv2 ILP32 data model

The reference PPU toolchain makes plain char signed in its default 32-bit
data model (predefining __CHAR_SIGNED__ and extending chars with extsb) and
unsigned under -mlp64.  Ours was unsigned in both, so char comparisons,
char-to-int conversions and C++ overload resolution on char differed from
code built with the reference.

Set flag_signed_char from the data model in option override, unless the user
passed -fsigned-char or -funsigned-char.  Option override runs before the
front end builds char_type_node and predefines __CHAR_UNSIGNED__, so the type
and the macro follow.  This is an ABI change for code that passes or
stores plain char; it ships with the other v0.20.0 ABI changes.

--- a/gcc/config/rs6000/rs6000.cc
+++ b/gcc/config/rs6000/rs6000.cc
@@ -3691,6 +3691,13 @@
   if (!OPTION_SET_P (flag_variable_expansion_in_unroller))
     flag_variable_expansion_in_unroller = 1;
 
+#ifdef POWERPC_CELL64LV2
+  /* Plain char is signed in the ILP32 data model and unsigned under -mlp64,
+     as in the reference toolchain, unless -f[un]signed-char was given.  */
+  if (!OPTION_SET_P (flag_signed_char))
+    flag_signed_char = !TARGET_LP64;
+#endif
+
   /* Set the pointer size.  */
   /* Pointer width follows the data model selected by -mlp64; the 64-bit
      ISA is always available regardless. */
--- a/gcc/config/rs6000/cell64lv2.h
+++ b/gcc/config/rs6000/cell64lv2.h
@@ -254,6 +254,9 @@
 	builtin_define ("_CALL_LINUX");		\
       builtin_assert ("cpu=powerpc64");		\
       builtin_assert ("machine=powerpc64");		\
+      /* Plain-char signedness, as the reference predefines it.  */ \
+      if (flag_signed_char)				\
+	builtin_define ("__CHAR_SIGNED__");		\
 						\
       /* Data-model axis: TARGET_LP64 is the multilib opt-in; \
          default is ILP32 hybrid. */ \
