// t_75de19a1: the spelled-out control for fp_scalar_ctor_broadcast_f - the
// same program with the scalar named three times.  Both spellings must
// compile to identical bytes.
struct Result { float4 colour : COLOR; };
Result main(float2 uv : TEXCOORD0, uniform sampler2D image)
{
    Result o;
    float b = tex2D(image, uv).b;
    o.colour.rgb = float3(b, b, b);
    o.colour.a = 1.0;
    return o;
}
