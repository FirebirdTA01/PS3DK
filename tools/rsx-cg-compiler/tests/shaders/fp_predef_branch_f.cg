// t_1704e79e: the SDK shape - a header that keeps the Cg declarations under
// #ifdef __CGC__ and C declarations (here an enum, which Cg rejects) in #else.
#ifdef __CGC__
uniform float4 K_d = { 0.5, 0.25, 0.125, 1.0 };
#else
enum { NOT_CG = 0 };
#endif
float4 main(float4 t : TEXCOORD0) : COLOR { return t * K_d; }
