// t_58e2212c: scalar tan lowers as sin/cos followed by DIVR.  The reference
// uses DIVR for scalar division only; vector tan stays on the per-lane
// RCP-then-MUL divide shape.
void main(float4 c : TEXCOORD0, out float4 o : COLOR)
{
    float t = tan(c.z);
    o = float4(t, t * 0.5, t * 0.25, 1.0);
}
