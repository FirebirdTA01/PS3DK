// The same defect through a SWIZZLE rather than a narrow input
// (t_14d18f02): `.xyz` of a float4 input is three lanes, not one.
//
//     out_position = float4(in_position.xyz, 1.0f);
//     ours       MOV o[0].x, v[0].x;
//                MOV o[0].y, c[467].x;    -> position (x, 1, -, -)
//     reference  MOV o[0].xyz, v[0].xyzx;
//                MOV o[0].w,   c[467].x;
//
// A position with two lanes never written does not rasterise, so the
// draw paints nothing at all - which is how the rig found it: our side
// of the pair was blank while the reference's covered the quad.
//
// Reduced from rsxgl's draw.vcg, which is in the corpus and is
// byte-identical to the reference once the constructor counts
// components.
void main(float4 in_position  : POSITION,
          float2 in_texcoord  : TEXCOORD0,
          out float4 out_position : POSITION,
          out float4 out_texcoord : TEXCOORD0)
{
    out_position = float4(in_position.xyz, 1.0f);
    out_texcoord = float4(in_texcoord, 0.0f, 1.0f);
}
