// k is exactly zero. The existing implementation/reference disagreement at
// this boundary is intentionally measured separately from root accuracy.
// This fixture does not authorize changing the total-internal-reflection rule.
float4 main(float4 a : TEXCOORD0) : COLOR {
    float3 r = refract(float3(a.x, a.y, 0.0), float3(0.0, 0.0, 1.0), 1.0);
    return float4(a.x, r.y * 0.25 + 0.5, a.z, 1.0);
}
