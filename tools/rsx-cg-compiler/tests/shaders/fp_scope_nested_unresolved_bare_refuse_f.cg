// t_36492ad8 commit 1.  RECORDING A NAME IS NOT DIAGNOSING IT.
//
// An error-typed argument SUPPRESSES the diagnostics on its call - measured
// both ways on sce-cgc 475 - but it must NOT suppress the record that the
// callee's NAME was used unresolved, because a later declaration of that name
// in the same scope is C1002 and the reference refuses it (review: codex).
//
// REFUSE: the same with a bare error-typed argument rather than a nested
// call, so the row does not depend on the argument being a CALL.
float4 unused(float4 t) { f(missing); float f; return t; }
float4 main(float4 t : TEXCOORD0) : COLOR { return t; }
