// Order preservation on the w/a lane: .w then .a must differ from .a
// then .w - a single lane has no partial-write structure to make an over-eager
// merge visible any other way.
struct R { float4 c : COLOR; };
R main(float2 uv : TEXCOORD0, uniform sampler2D t) { R r; r.c.xyz = tex2D(t,uv).xyz; r.c.w = tex2D(t,uv).x * 2.0; r.c.a = tex2D(t,uv).y; return r; }
