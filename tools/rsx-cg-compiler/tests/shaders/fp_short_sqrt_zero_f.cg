float4 main(float4 a : TEXCOORD0) : COLOR {
    // The diagonal has d==0 at runtime, so the oracle cannot decide it
    // through constant folding. Off-diagonal pixels also exercise both signs.
    float d = a.x - a.y;
    bool k = d == 0 && sqrt(d) == 0;
    return k ? float4(1,0.25,0.75,1) : float4(0.25,0.5,0.25,1);
}
