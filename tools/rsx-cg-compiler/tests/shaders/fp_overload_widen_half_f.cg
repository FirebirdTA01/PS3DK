// t_36492ad8 commit 2.  Measured against sce-cgc 475.
// The same rule with half rather than int: float->half is the narrowing, so
// clamp(float,float,float) wins again by widening the two half arguments.
float4 main(float4 t : TEXCOORD0) : COLOR { float f = t.x; half a = 0.0, b = 1.0; return clamp(f, a, b); }
