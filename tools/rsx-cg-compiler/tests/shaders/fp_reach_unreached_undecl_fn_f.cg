// t_36492ad8 commit 1.  THE C1008 "NAME NOT FOUND" CLASS IS REPORTED ONLY
// INSIDE FUNCTIONS REACHABLE FROM THE SELECTED ENTRY.  Measured against
// sce-cgc 475, sce_fp_rsx, helper never called from main:
//
//     undeclared identifier / undeclared function / forward call   ACCEPT
//     a type error (C1056) / a wrong arity (C1103)                 REFUSE
//
// So an unreachable body IS analysed - only this one class is gated.
//
// ACCEPT: an undeclared FUNCTION in an unreachable body.  Also pre-existing.
float4 unused(float4 t) { return nosuchfn(t); }
float4 main(float4 t : TEXCOORD0) : COLOR { return t; }
