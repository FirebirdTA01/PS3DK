// t_36492ad8 commit 1.  REFUSE: a UNIFORM DEFAULT INITIALISER roots the walk too, not just a static
// one.  `uniform float g = f(0.25);` reaches f's body and the reference
// name-checks it there.
float f(float t) { return missing; }
uniform float g = f(0.25);
float4 main(float4 t : TEXCOORD0) : COLOR { return t * g; }
