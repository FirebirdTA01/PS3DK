// A FORWARD tag: `typedef struct Foo Bar;` before `struct Foo { ... };`.
// The reference accepts this (and refuses the keyword-less `typedef Foo
// Bar;` in the same position).  Reference: byte-identical.
typedef struct Foo Bar;
struct Foo { float2 uv : TEXCOORD0; float3 col : TEXCOORD1; };
float4 main(Bar i) : COLOR { return float4(i.col * i.uv.x, 1); }
