// t_58e2212c: vector division by a scalar literal divisor follows the same
// reference fold as the scalar case: one vector MUL by the reciprocal, not
// per-lane RCP and not DIVR.
void main(float4 c : TEXCOORD0, out float4 o : COLOR)
{
    float3 q = c.xyz / 0.01;
    o = float4(q * 0.01, 1.0);
}
