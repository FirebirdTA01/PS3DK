// t_36492ad8 commit 2.  Measured against sce-cgc 475.
// The argument written out.  Twin of vp_helper_default_v.
float4 h(float4 c, float k = 0.5) { return c * k; }
void main(float4 in_position : POSITION,
          out float4 out_position : POSITION,
          out float4 out_color : COLOR)
{ out_position = in_position; out_color = h(in_position, 0.5); }
