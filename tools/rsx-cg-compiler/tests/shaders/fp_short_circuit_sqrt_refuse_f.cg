// Historical refusal witness, now accepted. The measured reference emits
// an unconditional DIVSQR, compares its result, and combines two booleans.
// The comparison, rather than the root value, feeds the logical multiply.
void main(float4 c : TEXCOORD0, out float4 o : COLOR)
{
    float x = c.x - 0.5;
    if (x >= 0.0 && sqrt(x) > 0.25) {
        o = float4(0.1, 0.8, 0.2, 1.0);
    } else {
        o = float4(0.7, 0.1, 0.1, 1.0);
    }
}
