// t_36492ad8 commit 2.  Measured against sce-cgc 475.
// A MATERIALISED DEFAULT REACHES WHAT IT CALLS.  inner carries a return
// semantic, which C5122 forbids on anything but the entry - and inner is
// reached ONLY because outer's default is substituted here.  The reference
// refuses; before this slice the call edge was invisible and we accepted.
float inner(float x) : COLOR { return x; }
float outer(float x, float k = inner(1.0)) { return x * k; }
float4 main(float4 t : TEXCOORD0) : COLOR { return float4(outer(t.x), 0, 0, 1); }
