// t_36492ad8 commit 2.  Measured against sce-cgc 475.
// A DIFFERENT default.  Must MOVE the container, or the VP twin above would
// be satisfied by a compiler that dropped the omitted argument entirely.
float4 h(float4 c, float k = 0.25) { return c * k; }
void main(float4 in_position : POSITION,
          out float4 out_position : POSITION,
          out float4 out_color : COLOR)
{ out_position = in_position; out_color = h(in_position); }
