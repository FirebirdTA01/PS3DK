// A file-scope uniform's initialiser is its COMPILED DEFAULT (t_3bf3ce95).
//
// The reference compiler writes the initialiser into the same inline const
// block that a runtime patch of that name later overwrites, so the shader
// does what the source says before anything patches it AND stays patchable.
// We emitted the block zero-filled and dropped the initialiser, so an
// unpatched shader computed with zero.
//
// THREE uniforms, each covering a case the others cannot:
//
//   tint   an explicit four-component initialiser - the straightforward case
//   splat  a SCALAR initialiser for a vector.  Cg broadcasts it, so this
//          means (0.5,0.5,0.5,0.5).  The first version of this fix stored
//          what the EXPRESSION held - one component - and produced
//          (0.5,0,0,0): right in x and zero elsewhere, which renders as a
//          plausible darker colour rather than as anything obviously wrong
//          (review finding, codex).  The original fixture used only a
//          four-component constructor and could not see it.
//   plain  NO initialiser, so its block must stay ZERO.  A fix that wrote
//          defaults into every uniform's block rather than only into those
//          declared with one would pass on the other two.
uniform float4 tint  = float4(0.25, 0.5, 0.75, 1.0);
uniform float4 splat = 0.5;
uniform float4 plain;

float4 main(float2 uv : TEXCOORD0) : COLOR
{
    return tint * splat * plain;
}
