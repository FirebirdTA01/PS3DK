// t_36492ad8 commit 2.  Measured against sce-cgc 475.
// A DEFAULT NAMING A const FILE-SCOPE GLOBAL.  The uniform row proves the
// expression is substituted rather than folded; this proves a const global
// resolves in the DECLARATION's scope, which is where the caller-scope capture
// defect lived.
static const float K = 0.5;
float4 h(float4 c, float k = K) { return c * k; }
float4 main(float4 t : TEXCOORD0) : COLOR { return h(t); }
