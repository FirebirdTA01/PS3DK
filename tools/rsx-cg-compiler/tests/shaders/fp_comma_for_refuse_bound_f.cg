// An init part that writes the BOUND: the trip count would be read before
// it runs.  Legal Cg (the reference accepts it); refused here by name
// rather than unrolled to the wrong count.
float4 main(float2 uv : TEXCOORD0) : COLOR { float s = 0; int i, n = 2; for (i = 0, n = 4; i < n; i++) s += uv.x; return float4(s, 0, 0, 1); }
