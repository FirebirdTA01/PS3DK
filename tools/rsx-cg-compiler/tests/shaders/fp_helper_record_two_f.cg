// TWO-ENTRY-STRUCT CONTROL: two entry inputs of DISTINCT struct types; the helper is given b only.
// Reference: b.col is referenced, a.col is not - stamping must name the owner the helper was
// bound to, not another entry parameter.  fp_helper_record_same_f is the shared-type case.
struct Tag { float2 uv : TEXCOORD0; float3 col : TEXCOORD1; };
struct Tag2 { float2 uv : TEXCOORD2; float3 col : TEXCOORD3; };
float3 helper(Tag2 t) { return t.col; }
float4 main(Tag a, Tag2 b) : COLOR { return float4(helper(b) * a.uv.x, 1); }
