// The Sony sce_fp_rsx reference rejects dynamic indexing of ordinary local
// arrays with C6013.  This pins that refusal so test_86-style local array
// indexing does not compile without a reference oracle.
float4 main(float2 uv : TEXCOORD0, uniform float4 time_param) : COLOR0
{
    float raw = time_param.x + uv.x + 4.0f;
    int idx = (int)floor(raw) % 4;

    float3 palette[4];
    palette[0] = float3(0.15f, 0.85f, 0.95f);
    palette[1] = float3(0.95f, 0.35f, 0.15f);
    palette[2] = float3(0.85f, 0.90f, 0.20f);
    palette[3] = float3(0.80f, 0.25f, 0.95f);

    float3 color = palette[idx];
    return float4(color, 1.0f);
}
