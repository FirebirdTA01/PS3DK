// function-visibility commit 2.  Measured against the established compiler.
// The reversed declaration order of fp_helper_default_out_amb_deffirst_refuse_f.
// The established compiler refuses identically, so the tie is not an ordering artefact.
void f(float4 c) { }
void f(float4 c, out float4 o = float4(0,0,0,1)) { o = c; }
float4 main(float4 t : TEXCOORD0) : COLOR { f(t); return t; }
