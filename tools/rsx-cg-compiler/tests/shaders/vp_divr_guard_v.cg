// t_b67cf02b: division on the vertex path uses scalar RCP plus vector MUL.
// The original fragment-only DIVR boundary witness must now compile with
// those measured vertex opcodes rather than an unmapped opcode or MOV.
void main(float4 p : POSITION,
          float4 q : TEXCOORD0,
          out float4 o : POSITION)
{
    float x = (p.x + 1.0) / (q.x + 2.0);
    o = float4(x, p.y, p.z, 1.0);
}
