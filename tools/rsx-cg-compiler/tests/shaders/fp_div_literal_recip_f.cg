// t_58e2212c: scalar division by a non-zero literal divisor follows the
// reference fold: multiply by the reciprocal literal, not DIVR and not RCP.
// 3.0 is deliberate: the reciprocal is inexact and the oracle emits the
// correctly rounded 0x3eaaaaab multiplier.
void main(float4 c : TEXCOORD0, out float4 o : COLOR)
{
    float x = (c.x + c.y * 0.25) / 3.0;
    o = float4(x, x * 0.5, x * 0.25, 1.0);
}
