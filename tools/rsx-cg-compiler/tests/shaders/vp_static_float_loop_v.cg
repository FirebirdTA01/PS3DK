// t_a290c3c8: preserve position and expose the loop result through TEXCOORD0.
void main(float4 p : POSITION, out float4 op : POSITION, out float4 o : TEXCOORD0)
{
    op = p;
    float4 a = float4(p.xy * 0.5 + 0.5, 0.0, 1.0);
    for (float i = -2.0; i < 2.0; i += 1.0)
        a = a.yzwx * 0.5 + float4(i * 0.015625, 0.0625, 0.03125, 0.125);
    o = a;
}
