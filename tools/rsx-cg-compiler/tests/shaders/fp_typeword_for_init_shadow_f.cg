// A for-init name shadows a struct tag only for the for statement: for (int B = 0; ...) {} B b; declares a B (reference sm27, twin).
struct B { float2 v; };
float4 main(float2 uv : TEXCOORD0) : COLOR { float s = 0; for (int B = 0; B < 1; ++B) { s += uv.x; } B b; b.v = uv; return float4(b.v, s, 1); }
