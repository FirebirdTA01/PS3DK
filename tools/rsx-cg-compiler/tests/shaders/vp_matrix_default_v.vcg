// Matrix reflection in the vertex container (t_4b54f26b A3, t_d90dbaed).
//
// THREE things at once, because they can only be seen together:
//   M    an INITIALISED file-scope matrix uniform.  The reference leaves the
//        PARENT record's defaultValue at 0 and puts each row's columns in the
//        row record's own 16-byte block, zero-padded.  We dropped all of it.
//   N    the same type with NO initialiser - the control that separates the
//        TYPE defects from the default-value work.  Its rows must carry no
//        block, and its types must still be right.
//   mvp  a 4x4, so the row type stays FLOAT4 and the fix is proven
//        COLUMN-SIZED rather than a blanket swap from FLOAT4 to FLOAT3.
//
// Measured on the reference: parent 1059 (CG_FLOAT3x3) with rows 1047
// (CG_FLOAT3) for a 3x3; parent 1064 with rows 1048 for a 4x4.  We emitted
// parent type 0 - no type at all - and FLOAT4 rows for every matrix.
//
// ASYMMETRIC values: a transposed or row-shifted fold cannot pass by luck.
float3x3 M = float3x3
	(
	   0.2209, 0.3390, 0.4184,
	   0.1138, 0.6780, 0.7319,
	   0.0102, 0.1130, 0.2969
	);
uniform float3x3 N;

void main(
	float4 position : POSITION,
	uniform float4x4 mvp,
	out float4 oPos : POSITION,
	out float4 oCol : COLOR0)
{
	oPos = mul(mvp, position);
	oCol = float4(mul(M, position.xyz) + mul(N, position.xyz), 1.0);
}
