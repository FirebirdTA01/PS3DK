// t_36492ad8 commit 2.  Measured against sce-cgc 475.
// CELL 1 OF 3.  A default expression naming an undeclared identifier is
// ACCEPTED when the helper is never reached from the entry point.  The
// reference analyses a default only for a REACHED function, so this compiles
// clean - a compiler that analysed every default unconditionally would refuse
// it and newly reject reference-accepted programs.
float4 h(float4 c, float k = nosuch) { return c * k; }
float4 main(float4 t : TEXCOORD0) : COLOR { return t; }
