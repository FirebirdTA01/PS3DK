// INTERIM refusal, to be DELETED by t_36492ad8 (t_4b54f26b A1).
//
// The reference ACCEPTS a default on a helper's parameter and materialises
// the omitted argument at the call site - sixteen reference-SDK rows, the
// whole Metallic family, depend on it.  We do not lower that yet, and letting
// it parse silently would compile the omitted argument as nothing, so it is
// refused BY NAME in the meantime.  This is a divergence we are choosing, not
// a rule we are matching: when t_36492ad8 lands, the refusal and this fixture
// go with it.
float3 shade(float3 base, const bool boost = true)
{
	return boost ? base * 2.0 : base;
}

void main(
	float2 texcoord : TEXCOORD0,
	out float4 color_out : COLOR)
{
	color_out = float4(shade(float3(texcoord, 0.5)), 1.0);
}
