// A block-local S s shadows the GLOBAL struct s; a helper called inside the block writes the
// real global's field. After the block, s.f is the global's field: 2*p (codex, composed boundary).
struct S { float4 f; };
S s;
void set(float4 q) { s.f = q * 2.0; }
float4 main(float4 p : TEXCOORD0) : COLOR { { S s; s.f = p * 3.0; set(p); } return s.f; }
