// preprocessor-defined-operator.  Measured against the established compiler.
// THE REINSERTION ROW.  #undef does not stop a driver-owned name
// expanding - it only stops it counting as defined.  After a source
// #define and a #undef, __LINE__ is back to the line number, and the
// use below sits on line 8.
#define __LINE__ 7
#undef __LINE__
float4 main() : COLOR { return __LINE__; }
