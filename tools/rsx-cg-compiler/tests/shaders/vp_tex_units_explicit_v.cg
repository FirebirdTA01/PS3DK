// Explicit vertex texture units, used and unused.
//   heightMap : TEXUNIT2 and maskMap : register(s3) - fetched, units 2 and 3
//   spareMap  : TEXUNIT1   - unused, keeps unit 1, isReferenced 0
//   farMap    : TEXUNIT7   - unused and out of range: accepted, no unit
//   idleMap                - unused, no unit
uniform sampler2D heightMap : TEXUNIT2;
uniform sampler2D maskMap : register(s3);
uniform sampler2D spareMap : TEXUNIT1;
uniform sampler2D farMap : TEXUNIT7;
uniform sampler2D idleMap;

void main(float2 uv : TEXCOORD0,
          out float4 position : POSITION,
          out float4 color : COLOR)
{
    position = tex2D(heightMap, uv);
    color = tex2D(maskMap, uv);
}
