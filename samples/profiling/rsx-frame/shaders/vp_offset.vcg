// rsx-frame sample: vertex program 0. The quad moved by a per-draw offset constant (the instance run changes only
// this constant, so every draw of the run keeps this program's identity).
void main(
    float2 in_position      : POSITION,
    float4 in_color         : COLOR,
    float2 in_uv            : TEXCOORD0,
    uniform float4 offset,
    out float4 out_position : POSITION,
    out float4 out_color    : COLOR,
    out float2 out_uv       : TEXCOORD0)
{
    out_position = float4(in_position + offset.xy, 0.5f, 1.0f);
    out_color = in_color;
    out_uv = in_uv;
}
