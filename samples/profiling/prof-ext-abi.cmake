# Data-model checks for the profiling samples that link the uninstalled SPU/RSX extension archives (make -C
# sdk/libps3dkprof ext-ilp32 / ext-lp64 [ext-live-ilp32 / ext-live-lp64]).  Configure-time, and independent of
# whether the linker would refuse a mixed-data-model link:
#   prof_ext_compiled_abi(<out>)  sets <out> to ilp32 or lp64 from the compiler's pointer size (CMAKE_SIZEOF_VOID_P);
#                                 any other size is a FATAL_ERROR.
#   prof_ext_require_abi(<abi> <what> <archive>)  every member of <archive> carries exactly one
#                                 Tag_GNU_Power_CellOS_Data_Model attribute, and it is <abi> (ILP32 or LP64); a
#                                 missing archive or readelf, an unreadable or unparsable output, a member without
#                                 the tag or with any other tag is a FATAL_ERROR naming <what>.
include_guard(GLOBAL)

function(prof_ext_compiled_abi out)
  if(CMAKE_SIZEOF_VOID_P EQUAL 4)
    set(${out} ilp32 PARENT_SCOPE)
  elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(${out} lp64 PARENT_SCOPE)
  else()
    message(FATAL_ERROR "the compiler's pointer size is '${CMAKE_SIZEOF_VOID_P}' (want 4 for ILP32 or 8 for LP64)")
  endif()
endfunction()

function(prof_ext_require_abi abi what archive)
  string(TOUPPER "${abi}" want)
  if(NOT want MATCHES "^(ILP32|LP64)$")
    message(FATAL_ERROR "${what}: unknown data model '${abi}'")
  endif()
  if(NOT EXISTS "${archive}" OR IS_DIRECTORY "${archive}")
    message(FATAL_ERROR "${what}: no archive at '${archive}'")
  endif()
  set(readelf "${CMAKE_READELF}")
  if(NOT readelf OR NOT EXISTS "${readelf}")
    get_filename_component(cc_dir "${CMAKE_C_COMPILER}" DIRECTORY)
    get_filename_component(cc_name "${CMAKE_C_COMPILER}" NAME)
    string(REGEX REPLACE "gcc(\\.exe)?$" "readelf\\1" re_name "${cc_name}")
    set(readelf "${cc_dir}/${re_name}")
  endif()
  if(NOT EXISTS "${readelf}" OR readelf STREQUAL "${CMAKE_C_COMPILER}")
    message(FATAL_ERROR "${what}: the toolchain's readelf was not found (tried '${readelf}')")
  endif()
  execute_process(COMMAND "${readelf}" -A "${archive}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${what}: '${readelf} -A' failed (rc ${rc}): ${err}")
  endif()
  string(REPLACE ";" "," out "${out}")
  string(REPLACE "\r" "" out "${out}")
  string(REPLACE "\n" ";" lines "${out}")
  set(member "")
  set(members "")
  foreach(line IN LISTS lines)
    string(STRIP "${line}" s)
    if(s MATCHES "^File: .*\\(([^()]+)\\)$")
      set(member "${CMAKE_MATCH_1}")
      if(member IN_LIST members)
        message(FATAL_ERROR "${what}: two attribute blocks for member ${member}")
      endif()
      list(APPEND members "${member}")
      set(tags_${member} "")
    elseif(s MATCHES "^Tag_GNU_Power_CellOS_Data_Model:[ \t]+([^ \t]+)$")
      if(member STREQUAL "")
        message(FATAL_ERROR "${what}: a data-model tag outside any member block")
      endif()
      list(APPEND tags_${member} "${CMAKE_MATCH_1}")
    elseif(s STREQUAL "" OR s STREQUAL "Attribute Section: gnu" OR s STREQUAL "File Attributes" OR s MATCHES "^Tag_")
    else()
      message(FATAL_ERROR "${what}: unrecognised readelf -A record '${s}'")
    endif()
  endforeach()
  list(LENGTH members n)
  if(n EQUAL 0)
    message(FATAL_ERROR "${what}: '${archive}' lists no members")
  endif()
  foreach(m IN LISTS members)
    if(NOT tags_${m} STREQUAL "${want}")
      message(FATAL_ERROR "${what}: member ${m} has data model [${tags_${m}}], want exactly [${want}] "
        "(SAMPLE_ABI / the toolchain and the archive must be the same data model)")
    endif()
  endforeach()
  message(STATUS "${what}: ${n} members, data model ${want}")
endfunction()
