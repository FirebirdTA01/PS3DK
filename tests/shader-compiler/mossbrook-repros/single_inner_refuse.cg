// The only return is inside a bare block.  Refused (already, by the inliner: a return inside control flow).
// (review: codex, 4f103738)  Reference: xyxy
struct Plan {float2 mirror[2];};
Plan pick(float4 t) { Plan r; r.mirror[0]=t.zw; r.mirror[1]=t.zw; { Plan r; r.mirror[0]=t.xy; r.mirror[1]=t.xy; return r; } }
float4 main(float4 t:TEXCOORD0):COLOR {Plan q=pick(t);return float4(q.mirror[0],q.mirror[1]);}
