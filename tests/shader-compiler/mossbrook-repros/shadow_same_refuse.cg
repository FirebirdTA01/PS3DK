// Inner-block r returned on one arm, a LATER top-level r on the other.  Refused (the inner arm is a scoped return).
// (review: codex, 4f103738)  Reference: t.x=0.75 -> xyxy, t.x=0.25 -> zwzw
struct Plan { float2 mirror[2]; };
Plan pick(float4 t) { if(t.x>0.5) { Plan r; r.mirror[0]=t.xy; r.mirror[1]=t.xy; return r; } Plan r; r.mirror[0]=t.zw; r.mirror[1]=t.zw; return r; }
float4 main(float4 t:TEXCOORD0):COLOR { Plan q=pick(t); return float4(q.mirror[0],q.mirror[1]); }
