// ONE returned declaration, but in an inner block under if(true): its storage is gone at block exit, which restores the outer r (t.zw); the remap installed zwzw.  Refused.
// (review: codex, 4f103738)  Reference: xyxy on both arms
struct Plan {float2 mirror[2];};
Plan pick(float4 t) { Plan r; r.mirror[0]=t.zw; r.mirror[1]=t.zw; if(true) { Plan r; r.mirror[0]=t.xy; r.mirror[1]=t.xy; return r; } return r; }
float4 main(float4 t:TEXCOORD0):COLOR {Plan q=pick(t);return float4(q.mirror[0],q.mirror[1]);}
