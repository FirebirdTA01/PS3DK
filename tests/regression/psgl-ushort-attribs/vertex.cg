void main(float4 position : POSITION, float4 value : COLOR0,
          float4 expected : TEXCOORD0,
          out float4 oPosition : POSITION, out float4 oColor : COLOR0)
{
    oPosition = position;
    oColor = float4(abs(value.x - expected.x) < 0.0000001 ? 1.0 : 0.0,
                   abs(value.y - expected.y) < 0.0000001 ? 1.0 : 0.0,
                   abs(value.z - expected.z) < 0.0000001 ? 1.0 : 0.0,
                   abs(value.w - expected.w) < 0.0000001 ? 1.0 : 0.0);
}
