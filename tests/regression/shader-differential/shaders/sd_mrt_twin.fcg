// control-mrt-mismatch twin of sd_mrt_ctrl.fcg: IDENTICAL except COLOR2's
// blue lane (0.5 -> 0.75).  A judge that reads only colour target 0 calls this
// pair identical; the all-outputs judge must name c2 and nothing else.
struct O {
    float4 c0 : COLOR0;
    float4 c1 : COLOR1;
    float4 c2 : COLOR2;
    float4 c3 : COLOR3;
};
O main(float4 tc : TEXCOORD0)
{
    O o;
    o.c0 = float4(tc.x, 0.0, 0.0, 1.0);
    o.c1 = float4(0.0, tc.y, 0.0, 1.0);
    o.c2 = float4(tc.x, tc.y, 0.75, 1.0);
    o.c3 = float4(0.25, 0.5, tc.x, 1.0);
    return o;
}
