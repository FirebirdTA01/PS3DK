// shader-differential — uniform-synthesis control, uniform side.
//
// Under uniform_set `auto` the guest gives u_auto the four values
// auto_value("u_auto", 0..3) (main.c).  The twin is GENERATED by the
// stager from its own Auto-Value copy with the same four numbers baked
// as exact-decimal literals; it never lives in the tree.  Identical iff
// the two arithmetic copies agree and the embedded-constant patch path
// applies them.  Same asymmetric shape as sd_uniform_ctrl.fcg.

void main(uniform float4 u_auto,
          out float4 color : COLOR)
{
    color = u_auto;
}
