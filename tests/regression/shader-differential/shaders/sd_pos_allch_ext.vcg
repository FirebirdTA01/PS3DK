// shader-differential — extended all-channel vertex program (NOT under test).
//
// sd_pos_allch drives TEXCOORD0..3 and COLOR0; the coverage FPs for FOG,
// COLOR1 and TEXCOORD4..9 had no proof row because no vertex program in
// the rig, the corpus or the tree writes those channels (measured
// 2026-09-02).  This VP writes every channel the rig can judge, with the
// same inputs and the same recipe for the base channels, and distinct
// non-constant functions for the rest, so an instrument row staged UNDER
// IT (manifest field vp=controls/vp_ext.vpo) proves each coverage FP on
// pixels against the reference's container of the same FP.  REFERENCE-
// compiled by the stager: an instrument must not rest on the compiler
// under test.
//
//   TEXCOORD4 = (0.2 + 0.6u, 0.9 - 0.7v, u*u, 0.3 + 0.4v)
//   TEXCOORD5 = (v*v, 0.1 + 0.8u, 0.95 - 0.6v, 0.5 + 0.3u*v)
//   TEXCOORD6 = (0.5 + 0.4u - 0.3v, 0.15 + 0.7v, 0.85 - 0.5u, u*v + 0.1)
//   TEXCOORD7 = (0.7 - 0.5v, 0.25 + 0.6u, 0.4 + 0.3u + 0.2v, 0.9 - 0.8u)
//   TEXCOORD8 = (0.3 + 0.5v, 0.8 - 0.6u, 0.2 + 0.3u + 0.4v, 0.6 - 0.4v)
//   TEXCOORD9 = (0.9 - 0.7u, 0.35 + 0.5v, 0.45 + 0.4u, 0.1 + 0.8v)
//   COLOR1    = (1 - v, u, 0.3 + 0.5v, 0.7 - 0.4u)
//   FOG       = 0.15 + 0.7 * u * v
// Every lane varies; none is exactly 0 or 1 at a pixel centre.
void main(
    float2 in_position       : POSITION,
    float2 in_texcoord       : TEXCOORD0,
    out float4 out_position  : POSITION,
    out float4 out_texcoord0 : TEXCOORD0,
    out float4 out_texcoord1 : TEXCOORD1,
    out float4 out_texcoord2 : TEXCOORD2,
    out float4 out_texcoord3 : TEXCOORD3,
    out float4 out_texcoord4 : TEXCOORD4,
    out float4 out_texcoord5 : TEXCOORD5,
    out float4 out_texcoord6 : TEXCOORD6,
    out float4 out_texcoord7 : TEXCOORD7,
    out float4 out_texcoord8 : TEXCOORD8,
    out float4 out_texcoord9 : TEXCOORD9,
    out float4 out_color     : COLOR0,
    out float4 out_color1    : COLOR1,
    out float  out_fog       : FOG)
{
    float u = in_texcoord.x;
    float v = in_texcoord.y;
    out_position  = float4(in_position.x, in_position.y, 0.0f, 1.0f);
    out_texcoord0 = float4(u, v, 0.1f + 0.5f * v, 0.92f - u);
    out_texcoord1 = float4(u - 0.5f, v - 0.5f, 0.3f + 0.4f * u, 0.4f + 0.5f * v);
    out_texcoord2 = float4(0.5f - u, 0.35f + 0.3f * v, v, 0.25f + 0.5f * u);
    out_texcoord3 = float4(u * v, u + v, 1.0f - u, 0.6f + 0.3f * u);
    out_texcoord4 = float4(0.2f + 0.6f * u, 0.9f - 0.7f * v, u * u, 0.3f + 0.4f * v);
    out_texcoord5 = float4(v * v, 0.1f + 0.8f * u, 0.95f - 0.6f * v, 0.5f + 0.3f * u * v);
    out_texcoord6 = float4(0.5f + 0.4f * u - 0.3f * v, 0.15f + 0.7f * v, 0.85f - 0.5f * u, u * v + 0.1f);
    out_texcoord7 = float4(0.7f - 0.5f * v, 0.25f + 0.6f * u, 0.4f + 0.3f * u + 0.2f * v, 0.9f - 0.8f * u);
    out_texcoord8 = float4(0.3f + 0.5f * v, 0.8f - 0.6f * u, 0.2f + 0.3f * u + 0.4f * v, 0.6f - 0.4f * v);
    out_texcoord9 = float4(0.9f - 0.7f * u, 0.35f + 0.5f * v, 0.45f + 0.4f * u, 0.1f + 0.8f * v);
    out_color     = float4(u, v, 1.0f - u, 1.0f - 1.05f * v);
    out_color1    = float4(1.0f - v, u, 0.3f + 0.5f * v, 0.7f - 0.4f * u);
    out_fog       = 0.15f + 0.7f * u * v;
}
