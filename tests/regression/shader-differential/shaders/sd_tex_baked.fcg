// shader-differential — texture-binding control, arithmetic twin.
//
// The procedural texture is 64x64 A8R8G8B8 with texel (x, y) =
// (R, G, B, A) = (4x, 4y, 4(63 - x), 4y) in 8-bit units.  At RT pixel
// (px, py) the interpolated texcoord is ((px + 0.5)/64, (py + 0.5)/64),
// so floor(uv * 64) recovers (px, py) with half a texel of margin, and
// the nearest-sampled texel is the same (px, py).  4/255 scaling makes
// every channel exactly representable after the RT's 8-bit quantisation.

void main(
    float4 in_texcoord   : TEXCOORD0,
    out float4 out_color : COLOR)
{
    float x = floor(in_texcoord.x * 64.0f);
    float y = floor(in_texcoord.y * 64.0f);
    float s = 4.0f / 255.0f;
    out_color = float4(x * s, y * s, (63.0f - x) * s, y * s);
}
