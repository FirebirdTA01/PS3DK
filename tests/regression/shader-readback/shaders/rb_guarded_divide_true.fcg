// shader-readback guarded divide row 2 -- statement branch, true arm selected.
//
// At the default probe pixel u is exactly 0.5/64, so the else arm divides by
// zero there.  The statement if/else shape forces frontend control flow; CF-1b
// predicated select lowering must commit the finite then value over the
// singular default value.  Alpha is 0.5 so a corrupted black color cannot be
// mistaken for the sentinel.

void main(
    float4 in_texcoord   : TEXCOORD0,
    out float4 out_color : COLOR)
{
    float u = in_texcoord.x;
    float probe_u = 0.0078125f;
    float r;
    if (u < 0.5f)
        r = 0.25f / (1.0f - u);
    else
        r = 0.25f / (u - probe_u);
    out_color = float4(r, r, r, 0.5f);
}
