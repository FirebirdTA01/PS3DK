# Explicit target selector. Include after project(), then call after adding
# the target's ordinary libraries. The link guard checks actual providers.
include_guard(GLOBAL)
function(ps3_target_prof_fifo target)
    cmake_parse_arguments(FIFO "" "ROOT" "" ${ARGN})
    if(FIFO_UNPARSED_ARGUMENTS OR NOT FIFO_ROOT OR NOT TARGET "${target}")
        message(FATAL_ERROR "ps3_target_prof_fifo needs an executable target and ROOT")
    endif()
    get_target_property(kind "${target}" TYPE)
    get_target_property(active "${target}" PS3_FIFO_ACTIVE)
    if(NOT kind STREQUAL EXECUTABLE OR active)
        message(FATAL_ERROR "FIFO selection requires an unselected executable")
    endif()
    if(CMAKE_VERSION VERSION_LESS 3.21 OR NOT CMAKE_GENERATOR MATCHES "Ninja|Makefiles")
        message(FATAL_ERROR "FIFO link guard requires CMake 3.21 and Ninja or Makefiles")
    endif()
    if(PS3_PROF_WAITS AND NOT PS3_PROF_WAITS STREQUAL "OFF")
        message(FATAL_ERROR "FIFO/waits composition is not supported")
    endif()
    get_filename_component(root "${FIFO_ROOT}" REALPATH)
    if(CMAKE_SIZEOF_VOID_P EQUAL 4)
        set(abi ilp32)
        set(lib "${root}/ppu/lib")
    elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(abi lp64)
        set(lib "${root}/ppu/lib/lp64")
    else()
        message(FATAL_ERROR "FIFO selection requires a known PPU pointer data model")
    endif()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    set(checker "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ps3-prof-fifo-check.py")
    set(args "${Python3_EXECUTABLE}" "${checker}" --root "${root}" --abi "${abi}")
    execute_process(COMMAND ${args} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "FIFO preflight refused: ${err}")
    endif()
    get_target_property(libs "${target}" LINK_LIBRARIES)
    if(NOT libs)
        set(libs "")
    endif()
    set(selected "")
    set(gcm_seen FALSE)
    set(prof_seen FALSE)
    foreach(item IN LISTS libs)
        if(item STREQUAL "gcm_cmd" OR item STREQUAL "${lib}/libgcm_cmd.a")
            list(APPEND selected "${lib}/libgcm_cmd_prof_fifo.a")
            set(gcm_seen TRUE)
            continue()
        elseif(item STREQUAL "ps3dkprof_ext" OR item STREQUAL "${lib}/libps3dkprof_ext.a" OR
               item STREQUAL "${lib}/libps3dkprof_ext_fifo.a")
            list(APPEND selected "${lib}/libps3dkprof_ext_fifo.a")
            set(prof_seen TRUE)
            continue()
        elseif(item MATCHES "(ps3dkprof|ps3prof)" AND NOT item STREQUAL "${lib}/libps3dkprof_ext_live.a")
            message(FATAL_ERROR "unsupported FIFO profiler composition: ${item}")
        endif()
        list(APPEND selected "${item}")
    endforeach()
    if(NOT prof_seen)
        list(APPEND selected "${lib}/libps3dkprof_ext_fifo.a")
    endif()
    if(NOT gcm_seen)
        list(APPEND selected "${lib}/libgcm_cmd_prof_fifo.a")
    endif()
    set_property(TARGET "${target}" PROPERTY LINK_LIBRARIES "${selected}")
    target_include_directories("${target}" BEFORE PRIVATE "${root}/ppu/include")
    # Force these definitions even for a small link-only consumer. Their
    # presence cannot be mistaken for an unexercised successful link.
    target_link_options("${target}" PRIVATE "-Wl,-u,ps3dk_prof_fifo_attach,-u,ps3dk_prof_fifo_detach,-u,ps3tc_fifo_wrap_callback")
    set(map "${CMAKE_CURRENT_BINARY_DIR}/${target}-fifo.map")
    target_link_options("${target}" PRIVATE "-Wl,-Map,${map},--cref")
    foreach(lang C CXX)
        get_target_property(old "${target}" "${lang}_LINKER_LAUNCHER")
        if(old)
            message(FATAL_ERROR "FIFO selection cannot replace an existing link launcher")
        endif()
        set_property(TARGET "${target}" PROPERTY "${lang}_LINKER_LAUNCHER" "${args};--map;${map};--command")
    endforeach()
    set_property(TARGET "${target}" PROPERTY PS3_FIFO_ACTIVE TRUE)
endfunction()
