# Included after project() has measured the selected PPU pointer data model.
# The normal toolchain and runtime remain unchanged unless explicitly selected.
get_property(_ps3_wait_try GLOBAL PROPERTY IN_TRY_COMPILE)
if(_ps3_wait_try)
    return()
endif()
get_property(_ps3_wait_active GLOBAL PROPERTY PS3_WAIT_ACTIVE)
if(_ps3_wait_active)
    return()
endif()
string(TOUPPER "${PS3_PROF_WAITS}" _ps3_wait_mode)
if(_ps3_wait_mode STREQUAL "OFF" OR _ps3_wait_mode STREQUAL "")
    return()
endif()
if(NOT _ps3_wait_mode MATCHES "^(MANUAL|AUTO|EXT)$")
    message(FATAL_ERROR "PS3_PROF_WAITS must be OFF, MANUAL, AUTO or EXT")
endif()
if(CMAKE_VERSION VERSION_LESS 3.21)
    message(FATAL_ERROR "Observed wait link checks require CMake 3.21 or newer")
endif()
if(NOT CMAKE_GENERATOR MATCHES "Ninja|Makefiles")
    message(FATAL_ERROR "Observed wait link checks require a Ninja or Makefiles generator")
endif()
set(PS3_PROF_WAITS_ROOT "${PS3DK}" CACHE PATH "SDK prefix holding the distinct observed archives")
if(CMAKE_SIZEOF_VOID_P EQUAL 4)
    set(_ps3_wait_abi ilp32)
    set(_ps3_wait_lib "${PS3_PROF_WAITS_ROOT}/ppu/lib")
elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(_ps3_wait_abi lp64)
    set(_ps3_wait_lib "${PS3_PROF_WAITS_ROOT}/ppu/lib/lp64")
else()
    message(FATAL_ERROR "Cannot determine the PPU data model for observed waits")
endif()
string(TOLOWER "${_ps3_wait_mode}" _ps3_wait_mode)
set(_ps3_wait_manual libps3dkprof_wait.a)
set(_ps3_wait_auto libps3prof_wait.a)
set(_ps3_wait_ext libps3dkprof_ext_wait.a)
set(_ps3_wait_archive "${_ps3_wait_lib}/${_ps3_wait_${_ps3_wait_mode}}")
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(_ps3_wait_checker "${CMAKE_CURRENT_LIST_DIR}/ps3-prof-waits-check.py")
set(_ps3_wait_include "${PS3_PROF_WAITS_ROOT}/ppu/include")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${_ps3_wait_checker}"
    --lib-dir "${_ps3_wait_lib}" --include-dir "${_ps3_wait_include}" --abi "${_ps3_wait_abi}" --mode "${_ps3_wait_mode}"
    RESULT_VARIABLE _ps3_wait_rc OUTPUT_VARIABLE _ps3_wait_stdout ERROR_VARIABLE _ps3_wait_stderr)
if(NOT _ps3_wait_rc EQUAL 0)
    message(FATAL_ERROR "Observed wait archive preflight refused: ${_ps3_wait_stderr}")
endif()
if(NOT EXISTS "${_ps3_wait_lib}/prof-waits/librt.a")
    message(FATAL_ERROR "Observed runtime linker redirect is missing")
endif()
# This directory is explicitly selected only here, so the compiler's implicit
# late -lrt resolves to the observed archive as well as the early toolchain -lrt.
link_directories(BEFORE "${_ps3_wait_lib}/prof-waits" "${_ps3_wait_lib}")
include_directories(BEFORE "${_ps3_wait_include}")
link_libraries("${_ps3_wait_archive}")
add_link_options("-Wl,-u,__ps3dk_prof_wait_config_anchor")
if(_ps3_wait_mode STREQUAL auto)
    add_link_options("-Wl,-u,__ps3dk_prof_startup_anchor")
endif()
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/prof-waits")
set(_ps3_wait_header "${CMAKE_BINARY_DIR}/prof-waits/data-model.h")
file(WRITE "${_ps3_wait_header}" "#if __SIZEOF_POINTER__ != ${CMAKE_SIZEOF_VOID_P}\n#error observed wait archive and target data models differ\n#endif\n")
add_compile_options("$<$<COMPILE_LANGUAGE:C,CXX>:-include>" "$<$<COMPILE_LANGUAGE:C,CXX>:${_ps3_wait_header}>")
set_property(GLOBAL PROPERTY PS3_WAIT_ACTIVE TRUE)
set_property(GLOBAL PROPERTY PS3_WAIT_CHECK_ARGS "${Python3_EXECUTABLE};${_ps3_wait_checker};--lib-dir;${_ps3_wait_lib};--include-dir;${_ps3_wait_include};--abi;${_ps3_wait_abi};--mode;${_ps3_wait_mode}")

function(_ps3_wait_check_targets directory)
    get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(_args GLOBAL PROPERTY PS3_WAIT_CHECK_ARGS)
    foreach(_target IN LISTS _targets)
        get_target_property(_type "${_target}" TYPE)
        if(_type STREQUAL EXECUTABLE)
            set(_map "${CMAKE_BINARY_DIR}/prof-waits/${_target}.map")
            target_link_options("${_target}" PRIVATE "-Wl,-Map,${_map},--cref")
            foreach(_lang C CXX)
                get_target_property(_old "${_target}" "${_lang}_LINKER_LAUNCHER")
                if(_old)
                    message(FATAL_ERROR "Observed waits require the link guard; ${_target} already has a linker launcher")
                endif()
                set_property(TARGET "${_target}" PROPERTY "${_lang}_LINKER_LAUNCHER" "${_args};--map;${_map};--command")
            endforeach()
        endif()
    endforeach()
    get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(_child IN LISTS _children)
        _ps3_wait_check_targets("${_child}")
    endforeach()
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _ps3_wait_check_targets "${CMAKE_SOURCE_DIR}")
