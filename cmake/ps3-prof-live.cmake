# Live viewer auto-start (PS3_PROF_LIVE_AUTOSTART=ON): every executable that links the profiler starts the live
# agent with no application code.  Opt-in; docs/profiler-guide.md "Live viewer auto-start" says when to turn it on
# and when to leave it off.  Included through CMAKE_PROJECT_INCLUDE by the PPU toolchain files; it runs at the end
# of the top-level directory, before the PS3_PROF_AUTO selector (registered after it), so the AUTO selector maps the
# live archive this adds.
#
# For each executable it selects:
#   - plain profiler links (ps3dkprof, ps3prof and their wait/func/counters variants carry the live members):
#     the link request only;
#   - extension links (ps3dkprof_ext and its fifo/func/counters forms) and PS3_PROF_AUTO: the matching
#     libps3dkprof_ext_live.a as well, unless the target already links it;
#   - PS3_PROF_WAITS (any mode): every executable, whose wait archive carries the live members.
# Every selected executable gets -Wl,-u,__ps3dk_prof_live_autostart_anchor, then net and sysmodule_stub.  The
# profiler archive is found through library targets too (INTERFACE and static wrappers).  An executable that links
# no profiler is left alone with a status line; a project where no executable links one fails to configure.  PS3_PROF_LIVE_PORT / PS3_PROF_LIVE_NET_POOL_KB other than the
# defaults add one generated source defining ps3dk_prof_live_autostart_settings.
get_property(_ps3_live_try GLOBAL PROPERTY IN_TRY_COMPILE)
if(_ps3_live_try)
    return()
endif()
get_property(_ps3_live_active GLOBAL PROPERTY PS3_LIVE_AUTOSTART_ACTIVE)
if(_ps3_live_active)
    return()
endif()
set_property(GLOBAL PROPERTY PS3_LIVE_AUTOSTART_ACTIVE TRUE)

set(PS3_PROF_LIVE_PORT 31750 CACHE STRING "Live viewer auto-start: TCP port (1..65535)")
set(PS3_PROF_LIVE_NET_POOL_KB 0 CACHE STRING
    "Live viewer auto-start: libnet memory pool in KiB when the profiler brings the network up first (0: libnet's 128 KiB netInitialize pool)")
if(NOT PS3_PROF_LIVE_PORT MATCHES "^[0-9]+$" OR PS3_PROF_LIVE_PORT LESS 1 OR PS3_PROF_LIVE_PORT GREATER 65535)
    message(FATAL_ERROR "PS3_PROF_LIVE_PORT must be 1..65535 (got '${PS3_PROF_LIVE_PORT}')")
endif()
if(NOT PS3_PROF_LIVE_NET_POOL_KB MATCHES "^[0-9]+$" OR PS3_PROF_LIVE_NET_POOL_KB GREATER 4096)
    message(FATAL_ERROR "PS3_PROF_LIVE_NET_POOL_KB must be 0..4096 (got '${PS3_PROF_LIVE_NET_POOL_KB}')")
endif()

# Every link item a target brings into its link, through library targets (their LINK_LIBRARIES and
# INTERFACE_LINK_LIBRARIES, $<LINK_ONLY:...> unwrapped, ALIAS targets resolved, imported locations included), so a
# profiler archive behind an INTERFACE or static wrapper library is found.  Other generator expressions are kept as
# text (a profiler archive named inside one still matches below).
function(_ps3_live_closure target out)
    set(seen "")
    set(items "")
    set(queue "${target}")
    while(queue)
        list(POP_FRONT queue t)
        if(t IN_LIST seen)
            continue()
        endif()
        list(APPEND seen "${t}")
        get_target_property(aliased "${t}" ALIASED_TARGET)
        if(aliased)
            list(APPEND queue "${aliased}")
            continue()
        endif()
        get_target_property(kind "${t}" TYPE)
        set(links "")
        if(NOT kind STREQUAL "INTERFACE_LIBRARY")
            get_target_property(l "${t}" LINK_LIBRARIES)
            if(l)
                list(APPEND links ${l})
            endif()
        endif()
        get_target_property(il "${t}" INTERFACE_LINK_LIBRARIES)
        if(il)
            list(APPEND links ${il})
        endif()
        get_target_property(imported "${t}" IMPORTED)
        if(imported)
            get_target_property(loc "${t}" IMPORTED_LOCATION)
            if(loc)
                list(APPEND items "${loc}")
            endif()
        endif()
        foreach(item IN LISTS links)
            if(item MATCHES "^\\$<LINK_ONLY:([^<>]+)>$")
                set(item "${CMAKE_MATCH_1}")
            endif()
            list(APPEND items "${item}")
            if(TARGET "${item}")
                list(APPEND queue "${item}")
            endif()
        endforeach()
    endwhile()
    set(${out} "${items}" PARENT_SCOPE)
endfunction()

function(_ps3_live_target target)
    _ps3_live_closure("${target}" items)
    set(profiler FALSE)
    set(ext FALSE)
    set(has_live FALSE)
    foreach(item IN LISTS items)
        if(item MATCHES "ps3dkprof_ext_live")
            set(has_live TRUE)
            set(profiler TRUE)
        elseif(item MATCHES "ps3dkprof_ext_wait")
            set(profiler TRUE)
        elseif(item MATCHES "ps3dkprof_ext")
            set(profiler TRUE)
            set(ext TRUE)
        elseif(item MATCHES "(^|[/\\\\]|lib)(ps3dkprof|ps3prof)([_.]|$)")
            set(profiler TRUE)
        endif()
    endforeach()
    if(PS3_PROF_AUTO)
        set(profiler TRUE)
        set(ext TRUE)
    endif()
    if(PS3_PROF_WAITS AND NOT PS3_PROF_WAITS STREQUAL "OFF")
        set(profiler TRUE)
    endif()
    if(NOT profiler)
        message(STATUS "PS3_PROF_LIVE_AUTOSTART: '${target}' links no profiler archive (searched through its library "
            "targets); left unchanged")
        return()
    endif()
    set_property(GLOBAL APPEND PROPERTY PS3_LIVE_AUTOSTART_TARGETS "${target}")
    if(ext AND NOT has_live)
        if(PS3_PROF_AUTO)
            # the AUTO selector maps this name onto its checked live archive
            target_link_libraries("${target}" PRIVATE ps3dkprof_ext_live)
        else()
            if(CMAKE_SIZEOF_VOID_P EQUAL 8)
                set(lib "${PS3DK}/ppu/lib/lp64")
            else()
                set(lib "${PS3DK}/ppu/lib")
            endif()
            if(NOT EXISTS "${lib}/libps3dkprof_ext_live.a")
                message(FATAL_ERROR "PS3_PROF_LIVE_AUTOSTART: target '${target}' links the profiler extension, but "
                    "${lib}/libps3dkprof_ext_live.a does not exist")
            endif()
            target_link_libraries("${target}" PRIVATE "${lib}/libps3dkprof_ext_live.a")
        endif()
    endif()
    target_link_options("${target}" PRIVATE "-Wl,-u,__ps3dk_prof_live_autostart_anchor")
    target_link_libraries("${target}" PRIVATE net sysmodule_stub)
    if(NOT PS3_PROF_LIVE_PORT EQUAL 31750 OR NOT PS3_PROF_LIVE_NET_POOL_KB EQUAL 0)
        get_property(langs GLOBAL PROPERTY ENABLED_LANGUAGES)
        if("C" IN_LIST langs)
            set(ext_name c)
        else()
            set(ext_name cpp)
        endif()
        set(src "${CMAKE_BINARY_DIR}/prof-live/${target}-live-options.${ext_name}")
        file(WRITE "${src}.tmp"
            "/* Generated by ps3-prof-live.cmake: PS3_PROF_LIVE_PORT, PS3_PROF_LIVE_NET_POOL_KB. */\n"
            "#include <ps3dk/prof.h>\n"
            "PS3DK_PROF_LIVE_AUTOSTART_OPTIONS(${PS3_PROF_LIVE_PORT}, ${PS3_PROF_LIVE_NET_POOL_KB});\n")
        file(COPY_FILE "${src}.tmp" "${src}" ONLY_IF_DIFFERENT)
        file(REMOVE "${src}.tmp")
        target_sources("${target}" PRIVATE "${src}")
        set_property(SOURCE "${src}" TARGET_DIRECTORY "${target}" APPEND PROPERTY COMPILE_DEFINITIONS PS3DK_PROF=1)
    endif()
    message(STATUS "PS3_PROF_LIVE_AUTOSTART: live viewer auto-start linked into '${target}' (port ${PS3_PROF_LIVE_PORT})")
endfunction()

function(_ps3_live_targets directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(kind "${target}" TYPE)
        if(kind STREQUAL EXECUTABLE)
            _ps3_live_target("${target}")
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        _ps3_live_targets("${child}")
    endforeach()
endfunction()
function(_ps3_live_start directory)
    _ps3_live_targets("${directory}")
    get_property(selected GLOBAL PROPERTY PS3_LIVE_AUTOSTART_TARGETS)
    if(NOT selected)
        message(FATAL_ERROR "PS3_PROF_LIVE_AUTOSTART=ON, but no executable in this project links a profiler archive "
            "(ps3dkprof, ps3prof, ps3dkprof_ext* or their variants), directly or through its library targets, and "
            "neither PS3_PROF_AUTO nor PS3_PROF_WAITS is on: the option would have no effect. Link the profiler, or "
            "turn the option off.")
    endif()
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _ps3_live_start "${CMAKE_SOURCE_DIR}")
